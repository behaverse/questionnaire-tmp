# Local config for the editor's /api/translate function (auto-translate). Copy to `.env.local`
# (gitignored via the `*.local` rule) and fill in. Server-side only — never reaches the browser.
#
# `npm run dev` now serves /api/translate locally via a dev shim (vite.config.ts), so auto-translate
# works on http://localhost:5173 without `vercel dev`. (`vercel dev` / a deploy still work too.)
#
# Provide ONE key. Both providers are supported and require funding on the respective account:

# Option A — direct Anthropic (uses your Anthropic credits; no Vercel card needed).
# Preferred automatically when set. Get a key at console.anthropic.com → API keys, and ensure you
# have credits under Plans & Billing.
ANTHROPIC_API_KEY=

# Option B — Vercel AI Gateway (model routed through gateway; needs a credit card on file to release
# the free credits). Get a key at vercel.com → AI Gateway → API Keys.
AI_GATEWAY_API_KEY=

# Optional — override the model. No "/" = direct-provider model (e.g. claude-haiku-4-5);
# with "/" = AI Gateway provider/model (e.g. anthropic/claude-sonnet-4-6).
# TRANSLATE_MODEL=claude-haiku-4-5

# --- /api/translate access guard (deployed function; spends your model key on each call) ---
# By default the function accepts only same-origin browser requests (the editor SPA). Extra origins:
# TRANSLATE_ALLOWED_ORIGINS=https://editor-static.vercel.app
# Hard lock: when set, callers MUST send `Authorization: Bearer <this>` (closes the endpoint fully;
# admits non-browser callers that hold the secret). Set this in production if the editor is private.
# TRANSLATE_SHARED_SECRET=
# Per-instance IP rate limit (requests/min; default 30, 0 disables).
# TRANSLATE_RATE_LIMIT=30
