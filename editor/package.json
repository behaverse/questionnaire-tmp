{
  "name": "questionnaire-editor",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "predev": "node scripts/ensure-renderer.mjs && node scripts/build-evaluator.mjs",
    "dev": "vite",
    "prebuild": "node scripts/ensure-renderer.mjs && node scripts/build-evaluator.mjs",
    "build": "tsc -b && tsc -p tsconfig.test.json && vite build",
    "pretypecheck": "node scripts/ensure-renderer.mjs",
    "typecheck": "tsc -b && tsc -p tsconfig.test.json",
    "preview": "vite preview --port 4175",
    "pretest": "node scripts/ensure-renderer.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "ai": "^6.0.208",
    "ajv": "^8.17.0",
    "ajv-formats": "^3.0.0",
    "immer": "^10.1.1",
    "lucide-react": "^1.20.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "fake-indexeddb": "^6.0.0",
    "jsdom": "^25.0.1",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2",
    "vite": "^6.0.5",
    "vitest": "^2.1.8"
  }
}
