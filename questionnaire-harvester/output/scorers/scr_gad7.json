{
  "content": {
    "en": {
      "description": "Standard GAD-7 scoring (Spitzer et al., 2006). Total = sum of the 7 items (each 0-3), range 0-21. Severity bands: 0-4 minimal, 5-9 mild, 10-14 moderate, 15-21 severe; a total of 10 or more is the usual cut-off for probable generalized anxiety disorder.",
      "name": "GAD-7 Standard Scoring",
      "status": "validated"
    }
  },
  "id": "scr_gad7",
  "implementations": [
    {
      "kind": "wasm",
      "sha256": "986687dbd269b2d10bbdf060b257fc15cbe2640dd38181c0dd0c844d6eea1687",
      "url": "https://behaverse.org/scorers/gad7/scorer.wasm"
    }
  ],
  "inputs": {
    "properties": {
      "scored_responses": {
        "patternProperties": {
          "^(pr_gad7_1|pr_gad7_2|pr_gad7_3|pr_gad7_4|pr_gad7_5|pr_gad7_6|pr_gad7_7)$": {
            "maximum": 3,
            "minimum": 0,
            "type": "integer"
          }
        },
        "type": "object"
      }
    },
    "required": [
      "scored_responses"
    ],
    "type": "object"
  },
  "name": "GAD-7 Standard Scoring",
  "output_schema": {
    "properties": {
      "missing_count": {
        "minimum": 0,
        "type": "integer"
      },
      "scores": {
        "properties": {
          "total": {
            "properties": {
              "band": {
                "properties": {
                  "label": {
                    "type": "string"
                  },
                  "max": {
                    "type": "number"
                  },
                  "min": {
                    "type": "number"
                  }
                },
                "required": [
                  "min",
                  "max",
                  "label"
                ],
                "type": "object"
              },
              "severity": {
                "enum": [
                  "minimal",
                  "mild",
                  "moderate",
                  "severe"
                ],
                "type": "string"
              },
              "value": {
                "type": "number"
              }
            },
            "required": [
              "value"
            ],
            "type": "object"
          }
        },
        "required": [
          "total"
        ],
        "type": "object"
      }
    },
    "required": [
      "scores",
      "missing_count"
    ],
    "type": "object"
  },
