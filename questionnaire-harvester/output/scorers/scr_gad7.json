            },
            "severity": "moderate",
            "value": 12
          }
        }
      },
      "input": {
        "scored_responses": {
          "pr_gad7_1": 2,
          "pr_gad7_2": 2,
          "pr_gad7_3": 2,
          "pr_gad7_4": 2,
          "pr_gad7_5": 2,
          "pr_gad7_6": 1,
          "pr_gad7_7": 1
        }
      },
      "name": "moderate-no-missing"
