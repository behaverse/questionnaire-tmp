            "value": 21
          }
        }
      },
      "input": {
        "scored_responses": {
          "pr_gad7_1": 3,
          "pr_gad7_2": 3,
          "pr_gad7_3": 3,
          "pr_gad7_4": 3,
          "pr_gad7_5": 3,
