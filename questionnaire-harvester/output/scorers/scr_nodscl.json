{
  "content": {
    "en": {
      "description": "NORC DSM-IV Screen for Gambling Problems (NODS). Counts the 10 DSM-IV pathological-gambling criteria met (a criterion counts if any of its items is endorsed; the two '3+ times' follow-ups are qualifiers), range 0-10: 1-2 at-risk, 3-4 problem gambling, 5+ pathological gambling.",
      "name": "NODS Gambling Screen Scoring",
      "status": "validated"
    }
  },
  "id": "scr_nodscl",
  "implementations": [
    {
      "kind": "wasm",
      "sha256": "f5acadffb523451f9f9d93cbcda7ea917d01b9e05d280fa63bc795b17e4a3265",
      "url": "https://behaverse.org/scorers/nodscl/scorer.wasm"
    }
  ],
  "inputs": {
    "properties": {
      "scored_responses": {
        "patternProperties": {
          "^pr_nodscl_[0-9]+$": {
            "maximum": 1,
            "minimum": 0,
            "type": "integer"
          }
        },
        "type": "object"
      }
    },
    "required": [
      "scored_responses"
    ],
    "type": "object"
  },
  "name": "NODS Gambling Screen Scoring",
  "output_schema": {
    "properties": {
      "band": {
        "properties": {
          "label": {
            "type": "string"
          },
          "max": {
            "type": "integer"
          },
          "min": {
            "type": "integer"
          }
        },
        "required": [
          "min",
          "max",
          "label"
        ],
        "type": "object"
      },
      "criteria_met": {
        "maximum": 10,
        "minimum": 0,
        "type": "integer"
      },
      "missing_count": {
        "maximum": 10,
        "minimum": 0,
        "type": "integer"
      },
      "severity": {
        "enum": [
          "none",
          "at_risk",
          "problem",
          "pathological"
        ],
        "type": "string"
      }
    },
    "required": [
      "criteria_met",
      "severity",
      "band",
      "missing_count"
    ],
    "type": "object"
  },
  "test_cases": [
    {
