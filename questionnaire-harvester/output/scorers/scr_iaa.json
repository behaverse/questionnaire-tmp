{
  "content": {
    "en": {
      "description": "Internet Addiction Assessment (IAA). Total = sum of the 18 items (each 0-4), range 0-72. Higher scores indicate greater problematic internet use (reverse-keyed items are reversed by the runtime). No standard severity cut-offs.",
      "name": "IAA Total Scoring",
      "status": "validated"
    }
  },
