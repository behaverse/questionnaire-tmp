{
  "content": {
    "en": {
      "description": "Shyness Scale (McCroskey). Total = sum of the 14 items (each 1-5), range 14-70. Higher scores indicate greater shyness (reverse-keyed items are reversed by the runtime). No standard severity cut-offs.",
      "name": "McCroskey Total Scoring",
      "status": "validated"
    }
  },
  "id": "scr_mcss",
  "implementations": [
    {
      "kind": "wasm",
      "sha256": "f05ac8fd5e0e7d50379445aede56aba4eadc90cf15c659158dbb3ef0b63b5fc5",
      "url": "https://behaverse.org/scorers/mcss/scorer.wasm"
    }
  ],
  "inputs": {
    "properties": {
      "scored_responses": {
        "patternProperties": {
          "^(pr_mcss_1|pr_mcss_2|pr_mcss_3|pr_mcss_4|pr_mcss_5|pr_mcss_6|pr_mcss_7|pr_mcss_8|pr_mcss_9|pr_mcss_10|pr_mcss_11|pr_mcss_12|pr_mcss_13|pr_mcss_14)$": {
            "maximum": 5,
            "minimum": 1,
            "type": "integer"
          }
        },
        "type": "object"
      }
    },
    "required": [
      "scored_responses"
    ],
    "type": "object"
  },
  "name": "McCroskey Total Scoring",
