{
  "content": {
    "en": {
      "description": "Montgomery-Asberg Depression Rating Scale (MADRS). Total = sum of the 10 clinician-rated items (each 0-6), range 0-60.",
      "name": "MADRS Scoring",
      "status": "validated"
    }
  },
  "id": "scr_madrs",
  "implementations": [
    {
      "kind": "wasm",
      "sha256": "4d43b94bdcbea31b259c5c8e9d4e158a4170c1b2d465dd615388f7110a59afe3",
      "url": "https://behaverse.org/scorers/madrs/scorer.wasm"
    }
  ],
  "inputs": {
    "properties": {
      "scored_responses": {
        "patternProperties": {
          "^(pr_madrs_1|pr_madrs_2|pr_madrs_3|pr_madrs_4|pr_madrs_5|pr_madrs_6|pr_madrs_7|pr_madrs_8|pr_madrs_9|pr_madrs_10)$": {
            "maximum": 6,
            "minimum": 0,
            "type": "integer"
          }
        },
        "type": "object"
      }
    },
    "required": [
      "scored_responses"
    ],
    "type": "object"
  },
  "name": "MADRS Scoring",
  "output_schema": {
    "properties": {
      "missing_count": {
        "minimum": 0,
        "type": "integer"
      },
      "scores": {
        "properties": {
          "total": {
            "properties": {
              "band": {
                "properties": {
                  "label": {
                    "type": "string"
                  },
                  "max": {
                    "type": "number"
                  },
                  "min": {
                    "type": "number"
                  }
                },
                "required": [
                  "min",
                  "max",
                  "label"
                ],
                "type": "object"
              },
              "severity": {
                "enum": [
                  "normal",
                  "mild",
                  "moderate",
                  "severe"
                ],
                "type": "string"
              },
              "value": {
                "type": "number"
              }
            },
            "required": [
              "value"
            ],
            "type": "object"
          }
        },
        "required": [
          "total"
        ],
        "type": "object"
      }
    },
    "required": [
      "scores",
      "missing_count"
    ],
    "type": "object"
  },
