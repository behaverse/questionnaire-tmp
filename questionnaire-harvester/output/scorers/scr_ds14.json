{
  "content": {
    "en": {
      "description": "Type D Personality (DS14). Type D Personality Scale (DS14; Denollet, 2005). Two 7-item subscale sums (each 0-4, range 0-28): Negative Affectivity (items 2,4,5,7,9,12,13) and Social Inhibition (1,3,6,8,10,11,14; items 1,3 reversed). A score of 10 or more on BOTH subscales indicates a Type D personality.",
      "name": "DS14 Scoring",
      "status": "validated"
    }
  },
