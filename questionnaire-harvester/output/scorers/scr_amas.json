{
  "content": {
    "en": {
      "description": "Abbreviated Math Anxiety Scale (AMAS). Total = sum of the 9 items (each 1-5), range 9-45. Higher scores indicate greater math anxiety (reverse-keyed items are reversed by the runtime). No standard severity cut-offs.",
      "name": "AMAS Total Scoring",
      "status": "validated"
    }
  },
  "id": "scr_amas",
  "implementations": [
    {
      "kind": "wasm",
