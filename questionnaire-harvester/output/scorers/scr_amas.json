      "url": "https://behaverse.org/scorers/amas/scorer.wasm"
    }
  ],
  "inputs": {
    "properties": {
      "scored_responses": {
        "patternProperties": {
          "^(pr_amas_1|pr_amas_2|pr_amas_3|pr_amas_4|pr_amas_5|pr_amas_6|pr_amas_7|pr_amas_8|pr_amas_9)$": {
            "maximum": 5,
            "minimum": 1,
            "type": "integer"
          }
        },
        "type": "object"
      }
    },
    "required": [
      "scored_responses"
    ],
    "type": "object"
  },
  "name": "AMAS Total Scoring",
  "output_schema": {
