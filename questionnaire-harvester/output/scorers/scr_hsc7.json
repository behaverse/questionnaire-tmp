{
  "content": {
    "en": {
      "description": "Hypoglycemia Symptoms Checklist (HSC-7). Total = sum of the 7 items (each 1-4), range 7-28. Higher scores indicate greater frequency of hypoglycemia symptoms (reverse-keyed items are reversed by the runtime). No standard severity cut-offs.",
      "name": "HSC-7 Total Scoring",
      "status": "validated"
    }
  },
  "id": "scr_hsc7",
  "implementations": [
    {
      "kind": "wasm",
      "sha256": "1f7acae5e57a4e9fcf8067bed06ffe815c6738bfac8197369af7dc973408a5c8",
      "url": "https://behaverse.org/scorers/hsc7/scorer.wasm"
    }
  ],
  "inputs": {
    "properties": {
      "scored_responses": {
        "patternProperties": {
          "^(pr_hsc7_1|pr_hsc7_2|pr_hsc7_3|pr_hsc7_4|pr_hsc7_5|pr_hsc7_6|pr_hsc7_7)$": {
            "maximum": 4,
            "minimum": 1,
            "type": "integer"
          }
        },
        "type": "object"
      }
    },
    "required": [
      "scored_responses"
    ],
    "type": "object"
  },
  "name": "HSC-7 Total Scoring",
  "output_schema": {
    "properties": {
      "missing_count": {
        "minimum": 0,
        "type": "integer"
      },
      "scores": {
        "properties": {
          "total": {
            "properties": {
              "value": {
                "type": "number"
              }
            },
            "required": [
              "value"
            ],
            "type": "object"
          }
        },
        "required": [
          "total"
        ],
        "type": "object"
      }
    },
    "required": [
      "scores",
      "missing_count"
    ],
    "type": "object"
  },
