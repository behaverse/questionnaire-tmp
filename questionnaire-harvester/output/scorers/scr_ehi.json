            },
            "severity": "left",
            "value": -100
          }
        }
      },
      "input": {
        "scored_responses": {
          "pr_ehi_1": -100,
          "pr_ehi_2": -100,
          "pr_ehi_3": -100,
          "pr_ehi_4": -100
        }
      },
