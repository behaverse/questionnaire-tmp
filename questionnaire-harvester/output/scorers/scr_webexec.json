{
  "content": {
    "en": {
      "description": "Problems with executive control (webexec). Total = sum of the 6 items (each 1-4), range 6-24. Higher scores indicate greater everyday executive-control problems (reverse-keyed items are reversed by the runtime). No standard severity cut-offs.",
      "name": "webexec Total Scoring",
      "status": "validated"
    }
  },
  "id": "scr_webexec",
  "implementations": [
    {
      "kind": "wasm",
      "sha256": "b35d7d3b8dc460a20a319611a3854af6f249c2e6bb130dd499282a07fa7dee13",
      "url": "https://behaverse.org/scorers/webexec/scorer.wasm"
    }
  ],
  "inputs": {
    "properties": {
      "scored_responses": {
        "patternProperties": {
          "^(pr_webexec_1|pr_webexec_2|pr_webexec_3|pr_webexec_4|pr_webexec_5|pr_webexec_6)$": {
            "maximum": 4,
            "minimum": 1,
            "type": "integer"
          }
        },
        "type": "object"
      }
    },
    "required": [
      "scored_responses"
    ],
    "type": "object"
  },
  "name": "webexec Total Scoring",
  "output_schema": {
