{
  "content": {
    "en": {
      "description": "WHO-5 Well-Being Index. Raw score = sum of the 5 items (each 0-5), range 0-25; the percentage score = raw x 4 (range 0-100). A percentage of 50 or below indicates reduced wellbeing and 28 or below suggests likely depression warranting further assessment.",
      "name": "WHO-5 Well-Being Index Scoring",
      "status": "validated"
    }
  },
  "id": "scr_who5",
  "implementations": [
    {
      "kind": "wasm",
      "sha256": "6f9afd140ea01ef2f30ad268e41d669ff96445601ac814accc06a4a39799f46d",
      "url": "https://behaverse.org/scorers/who5/scorer.wasm"
    }
  ],
  "inputs": {
    "properties": {
      "scored_responses": {
        "patternProperties": {
          "^(pr_who5_1|pr_who5_2|pr_who5_3|pr_who5_4|pr_who5_5)$": {
            "maximum": 5,
            "minimum": 0,
            "type": "integer"
          }
        },
        "type": "object"
      }
    },
    "required": [
      "scored_responses"
    ],
    "type": "object"
  },
  "name": "WHO-5 Well-Being Index Scoring",
  "output_schema": {
    "properties": {
      "missing_count": {
        "minimum": 0,
        "type": "integer"
      },
      "scores": {
        "properties": {
          "wellbeing": {
            "properties": {
              "band": {
                "properties": {
                  "label": {
                    "type": "string"
                  },
                  "max": {
                    "type": "number"
                  },
                  "min": {
                    "type": "number"
                  }
                },
                "required": [
                  "min",
                  "max",
                  "label"
                ],
                "type": "object"
              },
              "severity": {
                "enum": [
                  "likely_depression",
                  "low",
                  "normal"
                ],
                "type": "string"
              },
              "value": {
                "type": "number"
              }
            },
            "required": [
              "value"
            ],
            "type": "object"
          }
        },
        "required": [
          "wellbeing"
        ],
        "type": "object"
      }
    },
    "required": [
      "scores",
      "missing_count"
    ],
    "type": "object"
  },
  "test_cases": [
    {
      "expected": {
        "missing_count": 0,
        "scores": {
          "wellbeing": {
            "band": {
              "label": "Good wellbeing",
              "max": 100,
              "min": 51
            },
            "severity": "normal",
            "value": 100
          }
        }
      },
      "input": {
        "scored_responses": {
          "pr_who5_1": 5,
          "pr_who5_2": 5,
          "pr_who5_3": 5,
          "pr_who5_4": 5,
          "pr_who5_5": 5
        }
      },
      "name": "max-wellbeing"
    },
    {
      "expected": {
        "missing_count": 0,
        "scores": {
          "wellbeing": {
            "band": {
              "label": "Likely depression — further assessment indicated",
              "max": 28,
              "min": 0
            },
            "severity": "likely_depression",
            "value": 0
          }
        }
      },
      "input": {
        "scored_responses": {
          "pr_who5_1": 0,
          "pr_who5_2": 0,
          "pr_who5_3": 0,
          "pr_who5_4": 0,
          "pr_who5_5": 0
        }
      },
      "name": "likely-depression-floor"
    },
    {
      "expected": {
        "missing_count": 0,
        "scores": {
          "wellbeing": {
            "band": {
              "label": "Reduced wellbeing",
              "max": 50,
              "min": 29
            },
            "severity": "low",
            "value": 40
          }
        }
      },
      "input": {
        "scored_responses": {
          "pr_who5_1": 3,
          "pr_who5_2": 2,
          "pr_who5_3": 2,
          "pr_who5_4": 2,
          "pr_who5_5": 1
        }
      },
      "name": "reduced-wellbeing-band"
    }
  ],
  "x_publication": {
    "citation": "Topp CW, Østergaard SD, Søndergaard S, Bech P (2015). The WHO-5 Well-Being Index: a systematic review of the literature. Psychother Psychosom, 84(3), 167-176.",
    "year": 2015
  }
}