    }
  ],
  "inputs": {
    "properties": {
      "scored_responses": {
        "patternProperties": {
          "^(pr_rotter_1|pr_rotter_2|pr_rotter_3|pr_rotter_4|pr_rotter_5|pr_rotter_6|pr_rotter_7|pr_rotter_8|pr_rotter_9|pr_rotter_10|pr_rotter_11|pr_rotter_12|pr_rotter_13|pr_rotter_14|pr_rotter_15)$": {
