{
  "content": {
    "en": {
      "description": "Locus of control (Rotter, 1966). Rotter Internal-External Locus of Control (short form). External score = number of external-control choices across the 15 forced-choice items, range 0-15; higher = a more external locus of control.",
      "name": "LoC Scoring",
      "status": "validated"
    }
  },
  "id": "scr_rotter",
  "implementations": [
