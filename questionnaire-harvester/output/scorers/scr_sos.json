    }
  ],
  "inputs": {
    "properties": {
      "scored_responses": {
        "patternProperties": {
          "^(pr_sos_1|pr_sos_2|pr_sos_3|pr_sos_4|pr_sos_5|pr_sos_6|pr_sos_7|pr_sos_8|pr_sos_9|pr_sos_10|pr_sos_11|pr_sos_12)$": {
