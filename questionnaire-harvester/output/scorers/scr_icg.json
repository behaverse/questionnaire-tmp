{
  "content": {
    "en": {
      "description": "Inventory of Complicated Grief (Prigerson et al., 1995). Total = sum of the 19 items (each 0-4), range 0-76; a total above 25 indicates clinically significant complicated grief.",
      "name": "ICG Standard Scoring",
      "status": "validated"
    }
  },
  "id": "scr_icg",
  "implementations": [
