      "scored_responses": {
        "patternProperties": {
          "^(pr_icg_1|pr_icg_2|pr_icg_3|pr_icg_4|pr_icg_5|pr_icg_6|pr_icg_7|pr_icg_8|pr_icg_9|pr_icg_10|pr_icg_11|pr_icg_12|pr_icg_13|pr_icg_14|pr_icg_15|pr_icg_16|pr_icg_17|pr_icg_18|pr_icg_19)$": {
