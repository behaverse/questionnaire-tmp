{
  "content": {
    "en": {
      "description": "Positive and Negative Affect Schedule (Watson et al., 1988). Two 10-item subscales (each item 1-5, subscale range 10-50): Positive Affect (items 1,3,5,9,10,12,14,16,17,19) and Negative Affect (items 2,4,6,7,8,11,13,15,18,20). Higher = stronger affect; the scale has no standard severity cut-offs.",
      "name": "PANAS Standard Scoring",
      "status": "validated"
    }
  },
