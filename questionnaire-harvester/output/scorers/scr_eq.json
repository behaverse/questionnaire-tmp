{
  "content": {
    "en": {
      "description": "Empathy Quotient (Baron-Cohen & Wheelwright, 2004). Each of the 40 items scores 2/1/0 by direction (strong/slight empathic response = 2/1, else 0); total range 0-80, higher = more empathy. A total of 30 or below is typical of lower empathy.",
      "name": "EQ Standard Scoring",
      "status": "validated"
    }
  },
  "id": "scr_eq",
  "implementations": [
    {
      "kind": "wasm",
      "sha256": "dcb6174e868296aa843963c86d94dc1da117712a2ce37467d720971a949be6bd",
      "url": "https://behaverse.org/scorers/eq/scorer.wasm"
    }
  ],
  "inputs": {
    "properties": {
      "scored_responses": {
        "patternProperties": {
          "^pr_eq_(40|[1-3]?[0-9])$": {
            "maximum": 4,
            "minimum": 1,
            "type": "integer"
          }
        },
        "type": "object"
      }
    },
    "required": [
      "scored_responses"
    ],
    "type": "object"
  },
  "name": "EQ Standard Scoring",
  "output_schema": {
