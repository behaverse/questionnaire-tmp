{
  "content": {
    "en": {
      "description": "Cognitive Flexibility Scale (CFS). Total = sum of the 12 items (each 1-6), range 12-72. Higher scores indicate greater cognitive flexibility (reverse-keyed items are reversed by the runtime). No standard severity cut-offs.",
      "name": "CFS Total Scoring",
      "status": "validated"
    }
  },
  "id": "scr_cfs",
  "implementations": [
    {
      "kind": "wasm",
      "sha256": "806a49d6aafe09e1678c4095b64d6d6352c7561bd40f0c57041f5a346eb7c9d1",
      "url": "https://behaverse.org/scorers/cfs/scorer.wasm"
    }
  ],
  "inputs": {
    "properties": {
      "scored_responses": {
        "patternProperties": {
          "^(pr_cfs_1|pr_cfs_2|pr_cfs_3|pr_cfs_4|pr_cfs_5|pr_cfs_6|pr_cfs_7|pr_cfs_8|pr_cfs_9|pr_cfs_10|pr_cfs_11|pr_cfs_12)$": {
            "maximum": 6,
            "minimum": 1,
            "type": "integer"
          }
        },
        "type": "object"
      }
    },
    "required": [
      "scored_responses"
    ],
    "type": "object"
  },
  "name": "CFS Total Scoring",
  "output_schema": {
    "properties": {
      "missing_count": {
        "minimum": 0,
        "type": "integer"
      },
      "scores": {
        "properties": {
          "total": {
            "properties": {
              "value": {
                "type": "number"
              }
            },
            "required": [
              "value"
            ],
            "type": "object"
          }
        },
        "required": [
          "total"
        ],
        "type": "object"
      }
    },
    "required": [
      "scores",
      "missing_count"
    ],
    "type": "object"
  },
  "test_cases": [
