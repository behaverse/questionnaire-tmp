{
  "content": {
    "en": {
      "description": "Social Phobia Inventory (Connor et al., 2000). Total = sum of the 17 items (each 0-4), range 0-68. Severity: 0-20 none/minimal, 21-30 mild, 31-40 moderate, 41-50 severe, 51-68 very severe (a total of 19 or more suggests social anxiety disorder).",
      "name": "SPIN Standard Scoring",
      "status": "validated"
    }
  },
  "id": "scr_spin",
  "implementations": [
    {
      "kind": "wasm",
      "sha256": "f4f16b71ba5cde8e01d024fb2bc828748a72c7d158727fd014f8734edd039c38",
      "url": "https://behaverse.org/scorers/spin/scorer.wasm"
    }
  ],
  "inputs": {
    "properties": {
      "scored_responses": {
        "patternProperties": {
          "^(pr_spin_1|pr_spin_2|pr_spin_3|pr_spin_4|pr_spin_5|pr_spin_6|pr_spin_7|pr_spin_8|pr_spin_9|pr_spin_10|pr_spin_11|pr_spin_12|pr_spin_13|pr_spin_14|pr_spin_15|pr_spin_16|pr_spin_17)$": {
