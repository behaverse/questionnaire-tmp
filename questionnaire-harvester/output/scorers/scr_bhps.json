{
  "content": {
    "en": {
      "description": "Brief Histrionic Personality Scale (BHPS). Total = sum of the 11 items (each 1-4), range 11-44. Higher scores indicate greater histrionic personality traits (reverse-keyed items are reversed by the runtime). No standard severity cut-offs.",
      "name": "BHPS Total Scoring",
      "status": "validated"
    }
  },
  "id": "scr_bhps",
  "implementations": [
    {
      "kind": "wasm",
      "sha256": "4b32c2a959389421b929b0753af4ad2cf68ea33b97f5163c357996cd6d00a4b8",
      "url": "https://behaverse.org/scorers/bhps/scorer.wasm"
    }
  ],
  "inputs": {
    "properties": {
      "scored_responses": {
        "patternProperties": {
          "^(pr_bhps_1|pr_bhps_2|pr_bhps_3|pr_bhps_4|pr_bhps_5|pr_bhps_6|pr_bhps_7|pr_bhps_8|pr_bhps_9|pr_bhps_10|pr_bhps_11)$": {
            "maximum": 4,
            "minimum": 1,
            "type": "integer"
          }
        },
        "type": "object"
      }
    },
    "required": [
      "scored_responses"
    ],
    "type": "object"
  },
  "name": "BHPS Total Scoring",
  "output_schema": {
    "properties": {
      "missing_count": {
        "minimum": 0,
        "type": "integer"
      },
      "scores": {
        "properties": {
          "total": {
            "properties": {
              "value": {
                "type": "number"
              }
            },
            "required": [
              "value"
            ],
            "type": "object"
          }
        },
        "required": [
          "total"
        ],
        "type": "object"
      }
    },
    "required": [
      "scores",
      "missing_count"
    ],
    "type": "object"
  },
