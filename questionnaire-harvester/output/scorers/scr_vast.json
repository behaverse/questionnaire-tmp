{
  "content": {
    "en": {
      "description": "Varieties of Sadistic Tendencies (VAST). Sadism total = sum of the 16 sadism items (1-16; direct + vicarious, each 1-5; reverse-keyed items 4,6,9,15 reversed by the runtime), range 16-80; higher = greater sadistic tendencies. (Items 17-27 are a separate prosocial block and are not part of this score.)",
      "name": "VAST Sadism Scoring",
      "status": "validated"
    }
  },
  "id": "scr_vast",
  "implementations": [
