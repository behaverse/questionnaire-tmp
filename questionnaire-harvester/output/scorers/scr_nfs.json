{
  "content": {
    "en": {
      "description": "Nurturant Fathering Scale (NFS). Total = sum of the 9 items (each 1-5, range 9-45); higher = greater nurturant fathering (reverse-keyed items reversed by the runtime). No standard cut-offs.",
      "name": "NFS Total Scoring",
      "status": "validated"
    }
  },
  "id": "scr_nfs",
  "implementations": [
    {
      "kind": "wasm",
      "sha256": "b694bfaf5100aebfad0e34f9058cf57313927547374fd479e4ce6d6720fcbc5a",
      "url": "https://behaverse.org/scorers/nfs/scorer.wasm"
    }
  ],
  "inputs": {
    "properties": {
      "scored_responses": {
        "patternProperties": {
          "^(pr_nfs_1|pr_nfs_2|pr_nfs_3|pr_nfs_4|pr_nfs_5|pr_nfs_6|pr_nfs_7|pr_nfs_8|pr_nfs_9)$": {
            "maximum": 5,
            "minimum": 1,
            "type": "integer"
          }
        },
        "type": "object"
      }
    },
    "required": [
      "scored_responses"
    ],
    "type": "object"
  },
  "name": "NFS Total Scoring",
  "output_schema": {
    "properties": {
      "missing_count": {
        "minimum": 0,
        "type": "integer"
      },
      "scores": {
        "properties": {
          "total": {
            "properties": {
              "value": {
                "type": "number"
              }
            },
            "required": [
              "value"
            ],
            "type": "object"
          }
        },
        "required": [
          "total"
        ],
        "type": "object"
      }
    },
    "required": [
      "scores",
      "missing_count"
    ],
    "type": "object"
  },
