    }
  ],
  "inputs": {
    "properties": {
      "scored_responses": {
        "patternProperties": {
          "^(pr_pss_1|pr_pss_2|pr_pss_3|pr_pss_4|pr_pss_5|pr_pss_6|pr_pss_7|pr_pss_8|pr_pss_9|pr_pss_10|pr_pss_11|pr_pss_12|pr_pss_13|pr_pss_14)$": {
