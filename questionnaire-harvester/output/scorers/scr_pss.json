{
  "content": {
    "en": {
      "description": "Perceived Stress Scale-14 (Cohen et al., 1983). Total = sum of the 14 items (each 0-4; the 7 positively-worded items reverse-scored by the runtime), range 0-56; higher = greater perceived stress. (The 14-item version has no single standard cut-off.)",
      "name": "PSS-14 Standard Scoring",
      "status": "validated"
    }
  },
  "id": "scr_pss",
  "implementations": [
    {
      "kind": "wasm",
