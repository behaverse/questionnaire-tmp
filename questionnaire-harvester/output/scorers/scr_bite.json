{
  "content": {
    "en": {
      "description": "The Brief Irritability Test (BITe). Total = sum of the 5 items (each 1-6), range 5-30. Higher scores indicate greater irritability (reverse-keyed items are reversed by the runtime). No standard severity cut-offs.",
      "name": "BITe Total Scoring",
      "status": "validated"
    }
  },
  "id": "scr_bite",
  "implementations": [
    {
      "kind": "wasm",
      "sha256": "38f2dd524c6b9f77f465ba04c46f01f74bac7c0f8f4871f9d7a503176adbd673",
      "url": "https://behaverse.org/scorers/bite/scorer.wasm"
    }
  ],
  "inputs": {
    "properties": {
      "scored_responses": {
        "patternProperties": {
          "^(pr_bite_1|pr_bite_2|pr_bite_3|pr_bite_4|pr_bite_5)$": {
            "maximum": 6,
            "minimum": 1,
            "type": "integer"
          }
        },
        "type": "object"
      }
    },
    "required": [
      "scored_responses"
    ],
    "type": "object"
  },
  "name": "BITe Total Scoring",
  "output_schema": {
    "properties": {
      "missing_count": {
        "minimum": 0,
        "type": "integer"
      },
      "scores": {
        "properties": {
          "total": {
            "properties": {
              "value": {
                "type": "number"
              }
            },
            "required": [
              "value"
            ],
            "type": "object"
          }
        },
        "required": [
          "total"
        ],
        "type": "object"
      }
    },
    "required": [
      "scores",
      "missing_count"
    ],
    "type": "object"
  },
  "test_cases": [
    {
      "expected": {
        "missing_count": 0,
        "scores": {
          "total": {
            "value": 5
          }
        }
      },
      "input": {
        "scored_responses": {
          "pr_bite_1": 1,
          "pr_bite_2": 1,
          "pr_bite_3": 1,
          "pr_bite_4": 1,
          "pr_bite_5": 1
        }
      },
      "name": "floor"
    },
    {
      "expected": {
        "missing_count": 0,
        "scores": {
          "total": {
            "value": 15
          }
        }
      },
      "input": {
        "scored_responses": {
          "pr_bite_1": 3,
          "pr_bite_2": 3,
          "pr_bite_3": 3,
          "pr_bite_4": 3,
          "pr_bite_5": 3
        }
      },
      "name": "mid"
    },
    {
      "expected": {
        "missing_count": 0,
        "scores": {
          "total": {
            "value": 30
          }
        }
      },
      "input": {
        "scored_responses": {
          "pr_bite_1": 6,
          "pr_bite_2": 6,
          "pr_bite_3": 6,
          "pr_bite_4": 6,
          "pr_bite_5": 6
        }
      },
      "name": "ceiling"
    }
  ],
  "x_publication": {
    "citation": "Holtzman, S., O’Connor, B.P., Barata, P.C., and Stewart,\nD.E. (2015). The Brief Irritability Test (BITe): A Measure of\nIrritability for Use Among Men and Women. Assessment, 22 , 101-115. Read it for free via the US National Library of Medicine .",
    "year": 2015
  }
