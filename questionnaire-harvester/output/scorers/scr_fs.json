        "scored_responses": {
          "pr_fs_1": 1,
          "pr_fs_2": 1,
          "pr_fs_3": 1,
          "pr_fs_4": 1,
          "pr_fs_5": 1,
          "pr_fs_6": 1,
          "pr_fs_7": 1,
          "pr_fs_8": 1
        }
      },
