{
  "content": {
    "en": {
      "description": "Circadian Energy Scale (Ottoni et al., 2011). Chronotype = evening energy minus morning energy (each 1-5), range -4 to +4: <= -2 morning type, -1 to 1 neither, >= 2 evening type.",
      "name": "CIRENS Chronotype",
      "status": "validated"
    }
  },
  "id": "scr_cirens",
  "implementations": [
    {
      "kind": "wasm",
      "sha256": "5ee0605358a7807d13ace67d7a48c0379984b6fa41b868b22594b801cabbde6c",
      "url": "https://behaverse.org/scorers/cirens/scorer.wasm"
    }
  ],
  "inputs": {
    "properties": {
      "scored_responses": {
        "patternProperties": {
          "^pr_cirens_[12]$": {
            "maximum": 5,
            "minimum": 1,
            "type": "integer"
          }
        },
        "type": "object"
      }
    },
    "required": [
      "scored_responses"
    ],
    "type": "object"
  },
  "name": "CIRENS Chronotype",
  "output_schema": {
    "properties": {
      "chronotype": {
        "maximum": 4,
        "minimum": -4,
        "type": "integer"
      },
      "label": {
        "type": "string"
      },
      "type": {
        "enum": [
          "morning",
          "neither",
          "evening"
        ],
        "type": "string"
      }
    },
    "required": [
      "chronotype",
      "type",
      "label"
    ],
    "type": "object"
  },
  "test_cases": [
    {
      "expected": {
        "chronotype": -4,
        "label": "Morning type",
        "type": "morning"
      },
      "input": {
        "scored_responses": {
          "pr_cirens_1": 5,
          "pr_cirens_2": 1
        }
      },
      "name": "morning"
    },
    {
      "expected": {
        "chronotype": 4,
        "label": "Evening type",
        "type": "evening"
      },
      "input": {
        "scored_responses": {
          "pr_cirens_1": 1,
          "pr_cirens_2": 5
        }
      },
      "name": "evening"
    }
  ],
  "x_publication": {
    "citation": "Ottoni GL, Antoniolli E, Lara DR (2011). The Circadian Energy Scale (CIRENS): two simple questions for a reliable chronotype measurement based on energy. Chronobiol Int, 28(3), 229-237.",
    "year": 2011
  }
}