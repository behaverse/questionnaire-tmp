      "url": "https://behaverse.org/scorers/saps/scorer.wasm"
    }
  ],
  "inputs": {
    "properties": {
      "scored_responses": {
        "patternProperties": {
          "^(pr_saps_1|pr_saps_3|pr_saps_5|pr_saps_7|pr_saps_2|pr_saps_4|pr_saps_6|pr_saps_8)$": {
            "maximum": 7,
            "minimum": 1,
            "type": "integer"
          }
        },
        "type": "object"
      }
    },
    "required": [
      "scored_responses"
    ],
    "type": "object"
  },
  "name": "SAPS Scoring",
