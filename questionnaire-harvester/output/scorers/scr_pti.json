{
  "content": {
    "en": {
      "description": "70-item Myers-Briggs-style type sorter. Items map to four dichotomies by the 7-per-row grid (E/I, S/N x2, T/F x2, J/P x2); the first option favours E/S/T/J, the second I/N/F/P. The 4-letter type is the majority preference on each dichotomy.",
      "name": "Personality Type Indicator (MBTI-style)",
      "status": "validated"
    }
  },
  "id": "scr_pti",
  "implementations": [
    {
      "kind": "wasm",
      "sha256": "de71ca5186ba95df920276abad3d3d4cccbe2d624a31c4bbdc035639e7789d6e",
      "url": "https://behaverse.org/scorers/pti/scorer.wasm"
    }
  ],
  "inputs": {
    "properties": {
      "scored_responses": {
        "patternProperties": {
          "^pr_pti_[0-9]+$": {
            "maximum": 1,
            "minimum": 0,
            "type": "integer"
          }
        },
        "type": "object"
      }
    },
    "required": [
      "scored_responses"
    ],
    "type": "object"
  },
  "name": "Personality Type Indicator (MBTI-style)",
  "output_schema": {
    "properties": {
      "missing_count": {
        "maximum": 70,
        "minimum": 0,
        "type": "integer"
      },
      "type": {
        "pattern": "^[EI][SN][TF][JP]$",
        "type": "string"
      }
    },
    "required": [
      "type",
      "missing_count"
    ],
    "type": "object"
