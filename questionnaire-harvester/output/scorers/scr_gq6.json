{
  "content": {
    "en": {
      "description": "Gratitude Questionnaire-6 (McCullough et al., 2002). Total = sum of the 6 items (each 1-7; items 3 and 6 reverse-scored by the runtime), range 6-42; higher = greater dispositional gratitude. No standard severity cut-offs.",
      "name": "GQ-6 Standard Scoring",
      "status": "validated"
    }
  },
  "id": "scr_gq6",
  "implementations": [
    {
      "kind": "wasm",
      "sha256": "09447485757bb22c7f7df3e717557b9cf2989855932131b8f80ef838c4625e7b",
      "url": "https://behaverse.org/scorers/gq6/scorer.wasm"
    }
  ],
  "inputs": {
    "properties": {
      "scored_responses": {
        "patternProperties": {
          "^(pr_gq6_1|pr_gq6_2|pr_gq6_3|pr_gq6_4|pr_gq6_5|pr_gq6_6)$": {
            "maximum": 7,
            "minimum": 1,
            "type": "integer"
          }
        },
        "type": "object"
      }
    },
    "required": [
      "scored_responses"
    ],
    "type": "object"
  },
  "name": "GQ-6 Standard Scoring",
  "output_schema": {
    "properties": {
      "missing_count": {
        "minimum": 0,
        "type": "integer"
      },
      "scores": {
        "properties": {
          "total": {
            "properties": {
              "value": {
                "type": "number"
              }
            },
            "required": [
              "value"
            ],
            "type": "object"
          }
        },
        "required": [
          "total"
        ],
        "type": "object"
      }
    },
    "required": [
      "scores",
      "missing_count"
    ],
    "type": "object"
  },
