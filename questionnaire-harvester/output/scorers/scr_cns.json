{
  "content": {
    "en": {
      "description": "Connectedness to Nature Scale (CNS). Score = MEAN of the 14 items (each 1-5), range 1-5. Higher scores indicate greater felt connectedness to nature (reverse-keyed items are reversed by the runtime). No standard severity cut-offs.",
      "name": "CNS Total Scoring",
      "status": "validated"
    }
  },
