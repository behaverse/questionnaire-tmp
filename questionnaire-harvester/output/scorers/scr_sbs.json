{
  "content": {
    "en": {
      "description": "Supernatural Belief Scale. Total = sum of the 10 items (each -4-4, range -40-40); higher = greater belief in the supernatural (reverse-keyed items reversed by the runtime). No standard cut-offs.",
      "name": "SBS Total Scoring",
      "status": "validated"
    }
  },
  "id": "scr_sbs",
  "implementations": [
    {
      "kind": "wasm",
      "sha256": "e2585f96988f8fe7f2b1c97ba0e2649c8e93614ea9028029e5ff650ef957a88f",
      "url": "https://behaverse.org/scorers/sbs/scorer.wasm"
    }
  ],
  "inputs": {
    "properties": {
      "scored_responses": {
        "patternProperties": {
          "^(pr_sbs_1|pr_sbs_2|pr_sbs_3|pr_sbs_4|pr_sbs_5|pr_sbs_6|pr_sbs_7|pr_sbs_8|pr_sbs_9|pr_sbs_10)$": {
            "maximum": 4,
            "minimum": -4,
            "type": "integer"
          }
        },
        "type": "object"
      }
    },
    "required": [
      "scored_responses"
    ],
    "type": "object"
  },
  "name": "SBS Total Scoring",
  "output_schema": {
