{
  "content": {
    "en": {
      "description": "Lying in Everyday Situations Scale (LiES). Total = sum of the 14 items (each 1-7), range 14-98. Higher scores indicate greater frequency of everyday lying (reverse-keyed items are reversed by the runtime). No standard severity cut-offs.",
      "name": "LiES Total Scoring",
      "status": "validated"
    }
  },
  "id": "scr_lying",
