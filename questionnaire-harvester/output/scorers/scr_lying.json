    }
  ],
  "inputs": {
    "properties": {
      "scored_responses": {
        "patternProperties": {
          "^(pr_lying_1|pr_lying_2|pr_lying_3|pr_lying_4|pr_lying_5|pr_lying_6|pr_lying_7|pr_lying_8|pr_lying_9|pr_lying_10|pr_lying_11|pr_lying_12|pr_lying_13|pr_lying_14)$": {
