    "en": {
      "description": "Nomophobia Questionnaire (NMP-Q). Total = sum of the 20 items (each 1-7), range 20-140; higher = greater nomophobia (anxiety about being without one's smartphone) (reverse-keyed items reversed by the runtime). No standard cut-offs.",
      "name": "NMP-Q Total Scoring",
      "status": "validated"
    }
