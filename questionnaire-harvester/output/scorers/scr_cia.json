    }
  ],
  "inputs": {
    "properties": {
      "scored_responses": {
        "patternProperties": {
          "^(pr_cia_1|pr_cia_2|pr_cia_3|pr_cia_4|pr_cia_5|pr_cia_6|pr_cia_7|pr_cia_8|pr_cia_9|pr_cia_10|pr_cia_11|pr_cia_12|pr_cia_13|pr_cia_14|pr_cia_15|pr_cia_16)$": {
