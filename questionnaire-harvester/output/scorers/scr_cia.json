{
  "content": {
    "en": {
      "description": "Clinical Impairment Assessment Questionnaire (CIA 3.0). Total = sum of the 16 items (each 0-3), range 0-48; a total of 16 or more indicates clinically significant impairment.",
      "name": "CIA Scoring",
      "status": "validated"
    }
  },
  "id": "scr_cia",
