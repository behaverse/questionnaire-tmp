{
  "content": {
    "en": {
      "description": "Penn State Worry Questionnaire (PSWQ). Penn State Worry Questionnaire (Meyer et al., 1990). Total = sum of the 16 items (each 1-5; reverse items pre-scored), range 16-80; higher = more pathological worry (60+ is typical of GAD).",
      "name": "PSWQ Scoring",
      "status": "validated"
    }
  },
  "id": "scr_pswq",
