{
  "content": {
    "en": {
      "description": "Brief Resilience Scale (Smith et al., 2008). Score = MEAN of the 6 items (each 1-5; items 2,4,6 reverse-scored by the runtime), range 1.00-5.00. Interpretation: 1.00-2.99 low resilience, 3.00-4.30 normal resilience, 4.31-5.00 high resilience.",
      "name": "BRS Standard Scoring",
      "status": "validated"
    }
  },
  "id": "scr_brs",
  "implementations": [
    {
      "kind": "wasm",
      "sha256": "e4c9e26ac3431fba17e9037df607b6ba334c3d76ff71ad4ae4dcb1c0d4d1ef48",
      "url": "https://behaverse.org/scorers/brs/scorer.wasm"
    }
  ],
  "inputs": {
    "properties": {
      "scored_responses": {
        "patternProperties": {
          "^(pr_brs_1|pr_brs_2|pr_brs_3|pr_brs_4|pr_brs_5|pr_brs_6)$": {
            "maximum": 5,
            "minimum": 1,
            "type": "integer"
          }
        },
        "type": "object"
      }
    },
    "required": [
      "scored_responses"
    ],
    "type": "object"
  },
  "name": "BRS Standard Scoring",
  "output_schema": {
    "properties": {
      "missing_count": {
        "minimum": 0,
        "type": "integer"
      },
      "scores": {
        "properties": {
          "resilience": {
            "properties": {
              "band": {
                "properties": {
                  "label": {
                    "type": "string"
                  },
                  "max": {
                    "type": "number"
                  },
                  "min": {
                    "type": "number"
                  }
                },
                "required": [
                  "min",
                  "max",
                  "label"
                ],
                "type": "object"
              },
              "severity": {
                "enum": [
                  "low",
                  "normal",
                  "high"
                ],
                "type": "string"
              },
              "value": {
                "type": "number"
              }
            },
            "required": [
              "value"
            ],
            "type": "object"
          }
        },
        "required": [
          "resilience"
        ],
        "type": "object"
      }
    },
    "required": [
      "scores",
      "missing_count"
    ],
    "type": "object"
  },
  "test_cases": [
    {
      "expected": {
        "missing_count": 0,
        "scores": {
          "resilience": {
            "band": {
              "label": "Low resilience",
              "max": 2.99,
              "min": 1
            },
            "severity": "low",
            "value": 2
          }
        }
      },
      "input": {
        "scored_responses": {
          "pr_brs_1": 2,
          "pr_brs_2": 2,
          "pr_brs_3": 2,
          "pr_brs_4": 2,
          "pr_brs_5": 2,
          "pr_brs_6": 2
        }
      },
      "name": "low"
    },
    {
      "expected": {
        "missing_count": 0,
        "scores": {
          "resilience": {
            "band": {
              "label": "Normal resilience",
              "max": 4.3,
              "min": 3
            },
            "severity": "normal",
            "value": 3
          }
        }
      },
      "input": {
        "scored_responses": {
          "pr_brs_1": 3,
          "pr_brs_2": 3,
          "pr_brs_3": 3,
          "pr_brs_4": 3,
          "pr_brs_5": 3,
          "pr_brs_6": 3
        }
      },
      "name": "normal"
    },
    {
      "expected": {
        "missing_count": 0,
        "scores": {
          "resilience": {
            "band": {
              "label": "High resilience",
              "max": 5,
              "min": 4.31
            },
            "severity": "high",
            "value": 5
          }
        }
      },
      "input": {
        "scored_responses": {
          "pr_brs_1": 5,
          "pr_brs_2": 5,
          "pr_brs_3": 5,
          "pr_brs_4": 5,
          "pr_brs_5": 5,
          "pr_brs_6": 5
        }
      },
      "name": "high"
    }
  ],
  "x_publication": {
    "citation": "Smith BW, Dalen J, Wiggins K, Tooley E, Christopher P, Bernard J (2008). The brief resilience scale: assessing the ability to bounce back. Int J Behav Med, 15(3), 194-200.",
    "year": 2008
  }
}