{
  "content": {
    "en": {
      "description": "Generalized Acceptance of EvolutioN Evaluation (GAENE). Total = sum of the 13 items (each 1-5), range 13-65. Higher scores indicate greater acceptance of evolution (reverse-keyed items are reversed by the runtime). No standard severity cut-offs.",
      "name": "GAENE Total Scoring",
      "status": "validated"
    }
  },
  "id": "scr_gaene",
