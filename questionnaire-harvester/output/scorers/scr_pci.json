{
  "content": {
    "en": {
      "description": "Procrastinatory Cognitions Inventory (PCI). Total = sum of the 18 items (each 0-4), range 0-72. Higher scores indicate greater procrastinatory cognitions (reverse-keyed items are reversed by the runtime). No standard severity cut-offs.",
      "name": "PCI Total Scoring",
      "status": "validated"
    }
  },
  "id": "scr_pci",
