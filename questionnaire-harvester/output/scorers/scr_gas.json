{
  "content": {
    "en": {
      "description": "Gaming Addiction Scale. Total = sum of the 7 items (each 0-1, range 0-7); higher = greater addictive gaming behaviour (reverse-keyed items reversed by the runtime). No standard cut-offs.",
      "name": "GAS Total Scoring",
      "status": "validated"
    }
  },
  "id": "scr_gas",
  "implementations": [
    {
      "kind": "wasm",
