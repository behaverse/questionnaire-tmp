      "url": "https://behaverse.org/scorers/gas/scorer.wasm"
    }
  ],
  "inputs": {
    "properties": {
      "scored_responses": {
        "patternProperties": {
          "^(pr_gas_1|pr_gas_2|pr_gas_3|pr_gas_4|pr_gas_5|pr_gas_6|pr_gas_7)$": {
            "maximum": 1,
            "minimum": 0,
            "type": "integer"
          }
        },
        "type": "object"
      }
    },
    "required": [
      "scored_responses"
    ],
    "type": "object"
  },
  "name": "GAS Total Scoring",
