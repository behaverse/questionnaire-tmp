{
  "content": {
    "en": {
      "description": "Shutdown Dissociation Scale (SHUT-D). Total = sum of the 13 items (each 0-3, range 0-39); higher = greater shutdown dissociation (reverse-keyed items reversed by the runtime). No standard cut-offs.",
      "name": "SHUT-D Total Scoring",
      "status": "validated"
    }
  },
  "id": "scr_shutd",
  "implementations": [
    {
      "kind": "wasm",
      "sha256": "c296f24b0c0691000da067df81d0817afd507318d5c550202246cbec2073628a",
      "url": "https://behaverse.org/scorers/shutd/scorer.wasm"
    }
  ],
  "inputs": {
    "properties": {
      "scored_responses": {
        "patternProperties": {
          "^(pr_shutd_1|pr_shutd_2|pr_shutd_3|pr_shutd_4|pr_shutd_5|pr_shutd_6|pr_shutd_7|pr_shutd_8|pr_shutd_9|pr_shutd_10|pr_shutd_11|pr_shutd_12|pr_shutd_13)$": {
            "maximum": 3,
            "minimum": 0,
            "type": "integer"
          }
        },
        "type": "object"
      }
    },
    "required": [
      "scored_responses"
    ],
    "type": "object"
  },
  "name": "SHUT-D Total Scoring",
  "output_schema": {
