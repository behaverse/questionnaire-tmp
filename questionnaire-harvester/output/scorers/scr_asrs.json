{
  "content": {
    "en": {
      "description": "Adult ADHD Self-Report Scale v1.1 Part A (Kessler et al., 2005). Counts the 6 screener items in the grey zone (items 1-3 answered 'Sometimes' or more; items 4-6 'Often' or more), range 0-6; 4 or more is highly consistent with ADHD.",
      "name": "ASRS Part-A Screener",
      "status": "validated"
    }
  },
  "id": "scr_asrs",
  "implementations": [
    {
      "kind": "wasm",
      "sha256": "84e6a72499f5e96609bf875d853ea0193e2b9dcfd748d71220f3ca119cc79719",
      "url": "https://behaverse.org/scorers/asrs/scorer.wasm"
    }
  ],
  "inputs": {
    "properties": {
      "scored_responses": {
        "patternProperties": {
          "^pr_asrs_[1-6]$": {
            "maximum": 5,
            "minimum": 1,
            "type": "integer"
          }
        },
        "type": "object"
      }
    },
    "required": [
      "scored_responses"
    ],
    "type": "object"
  },
  "name": "ASRS Part-A Screener",
  "output_schema": {
    "properties": {
      "band": {
        "properties": {
          "label": {
            "type": "string"
          },
          "max": {
            "type": "integer"
          },
          "min": {
            "type": "integer"
          }
        },
        "required": [
          "min",
          "max",
          "label"
        ],
        "type": "object"
      },
      "missing_count": {
        "maximum": 6,
        "minimum": 0,
        "type": "integer"
      },
      "part_a": {
        "maximum": 6,
        "minimum": 0,
        "type": "integer"
      },
      "severity": {
        "enum": [
          "negative",
          "positive"
        ],
        "type": "string"
      }
    },
    "required": [
      "part_a",
      "severity",
      "band",
      "missing_count"
    ],
    "type": "object"
  },
  "test_cases": [
    {
      "expected": {
        "band": {
          "label": "Symptoms highly consistent with ADHD — further investigation warranted",
          "max": 6,
          "min": 4
        },
        "missing_count": 0,
        "part_a": 6,
        "severity": "positive"
      },
      "input": {
        "scored_responses": {
          "pr_asrs_1": 3,
          "pr_asrs_2": 3,
          "pr_asrs_3": 3,
          "pr_asrs_4": 4,
          "pr_asrs_5": 4,
          "pr_asrs_6": 4
        }
      },
      "name": "positive"
    },
    {
      "expected": {
        "band": {
          "label": "Symptoms not consistent with ADHD",
          "max": 3,
          "min": 0
        },
        "missing_count": 0,
        "part_a": 3,
        "severity": "negative"
      },
      "input": {
        "scored_responses": {
          "pr_asrs_1": 3,
          "pr_asrs_2": 3,
          "pr_asrs_3": 3,
          "pr_asrs_4": 3,
          "pr_asrs_5": 3,
          "pr_asrs_6": 3
        }
      },
      "name": "negative"
    }
  ],
  "x_publication": {
    "citation": "Kessler RC, Adler L, Ames M, et al. (2005). The World Health Organization Adult ADHD Self-Report Scale (ASRS). Psychol Med, 35(2), 245-256.",
    "year": 2005
  }
}