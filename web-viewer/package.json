{
  "name": "questionnaire-web-viewer",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "predev": "node scripts/build-scorer-host.mjs && node scripts/build-evaluator.mjs",
    "build": "tsc -b && tsc -p tsconfig.test.json && vite build",
    "prebuild": "node scripts/build-scorer-host.mjs && node scripts/build-evaluator.mjs",
    "pretest": "node scripts/build-scorer-host.mjs && node scripts/build-evaluator.mjs",
    "build:evaluator": "node scripts/build-evaluator.mjs",
    "typecheck": "tsc -b && tsc -p tsconfig.test.json",
    "preview": "vite preview --port 4174",
    "test": "vitest run && node scripts/validate-manifest.mjs",
    "test:watch": "vitest",
    "build:lib": "vite build -c vite.config.lib.ts && tsc -p tsconfig.lib.json",
    "test:lib": "npm run build:lib && vitest run -c vite.config.lib-test.ts"
  },
  "exports": {
    ".": "./src/main.tsx",
    "./renderer": {
      "types": "./dist-lib/lib.d.ts",
      "import": "./dist-lib/renderer.js"
    },
    "./renderer/style.css": "./dist-lib/renderer.css"
  },
  "dependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/node": "^25.9.3",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "ajv": "^8.17.0",
    "ajv-formats": "^3.0.0",
    "autoprefixer": "^10.4.20",
    "axe-core": "^4.10.0",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^25.0.1",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2",
    "vite": "^6.0.5",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^2.1.8",
    "vitest-axe": "^0.1.0"
  }
}
