{
  "@context": {
    "@vocab":          "https://behaverse.org/schemas/questionnaire#",
    "questionnaire":   "https://behaverse.org/schemas/questionnaire#",
    "instrument":      "https://behaverse.org/schemas/instrument#",
    "schema":          "http://schema.org/",
    "dc":              "http://purl.org/dc/terms/",

    "id":              "@id",
    "metadata":        { "@id": "instrument:metadata", "@context": "https://behaverse.org/schemas/instrument/context.jsonld" },
    "style":           { "@id": "questionnaire:style" },
    "flow":            { "@id": "questionnaire:flow" },
    "pages":           { "@id": "questionnaire:pages", "@container": "@list" },
    "blocks":          { "@id": "questionnaire:blocks", "@container": "@set" },
    "subscales":       { "@id": "questionnaire:subscales", "@container": "@set" },
    "scores":          { "@id": "questionnaire:scores",          "@container": "@set"  },
    "logic":           { "@id": "questionnaire:logic", "@container": "@set" },
    "validation":      { "@id": "questionnaire:validation", "@container": "@set" },

    "elements":        { "@id": "questionnaire:elements", "@container": "@list" },
    "page_ids":        { "@id": "questionnaire:page_ids", "@container": "@set" },
    "prompt_ids":      { "@id": "questionnaire:prompt_ids", "@container": "@set" },
    "implementations": { "@id": "questionnaire:implementations", "@container": "@set"  },
    "test_cases":      { "@id": "questionnaire:test_cases",      "@container": "@set"  },

    "prompt":          { "@id": "questionnaire:prompt" },
    "context":         { "@id": "questionnaire:context" },
    "instruction":     { "@id": "questionnaire:instruction" },
    "question":        { "@id": "questionnaire:question" },
    "option":          { "@id": "questionnaire:option" },
    "shared_option":   { "@id": "questionnaire:shared_option" },
    "placeholder":     { "@id": "questionnaire:placeholder" },
    "help":            { "@id": "questionnaire:help" },
    "input_validation":{ "@id": "questionnaire:input_validation" },
    "expected_response":{ "@id": "questionnaire:expected_response" },
    "score":           { "@id": "questionnaire:score" },
    "scorer":          { "@id": "questionnaire:scorer",          "@type": "@id" },
    "path":            { "@id": "questionnaire:path" },
    "inputs":          { "@id": "questionnaire:inputs" },
    "output_schema":   { "@id": "questionnaire:output_schema" },

    "content":         { "@id": "questionnaire:content", "@container": "@language" },
    "construct":       { "@id": "questionnaire:construct" },
    "dimension":       { "@id": "questionnaire:dimension" },
    "reversed":        { "@id": "questionnaire:reversed" },
    "topics":          { "@id": "questionnaire:topics", "@container": "@set" },
    "lock_show_score_timing": { "@id": "questionnaire:lock_show_score_timing" },

    "ref":             { "@id": "questionnaire:ref", "@type": "@id" },
    "condition":       { "@id": "questionnaire:condition" },
    "action":          { "@id": "questionnaire:action" },
    "formula":         { "@id": "questionnaire:formula" }
  }
}
