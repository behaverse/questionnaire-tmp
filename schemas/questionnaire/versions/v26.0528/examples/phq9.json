      "title": "Symptoms over the past 2 weeks",
      "entries": [
        {
          "id": "sec_phq9",
          "title": "Over the last 2 weeks, how often have you been bothered by any of the following problems?",
          "shared_option_set": {
            "id": "os_phq9_likert",
            "options": [
              { "value": 0, "text": "Not at all" },
              { "value": 1, "text": "Several days" },
              { "value": 2, "text": "More than half the days" },
              { "value": 3, "text": "Nearly every day" }
            ]
          },
          "questions": [
            { "id": "q_phq9_1", "type": "radio", "prompt": "Little interest or pleasure in doing things.",
              "properties": { "option_set": {
                "options": [
                  { "value": 0, "text": "Not at all" },
                  { "value": 1, "text": "Several days" },
                  { "value": 2, "text": "More than half the days" },
                  { "value": 3, "text": "Nearly every day" }
                ]
              }}},
            { "id": "q_phq9_2", "type": "radio", "prompt": "Feeling down, depressed, or hopeless.",
              "properties": { "option_set": {
                "options": [
                  { "value": 0, "text": "Not at all" },
                  { "value": 1, "text": "Several days" },
                  { "value": 2, "text": "More than half the days" },
                  { "value": 3, "text": "Nearly every day" }
                ]
              }}},
            { "id": "q_phq9_3", "type": "radio", "prompt": "Trouble falling or staying asleep, or sleeping too much.",
              "properties": { "option_set": {
                "options": [
                  { "value": 0, "text": "Not at all" },
                  { "value": 1, "text": "Several days" },
                  { "value": 2, "text": "More than half the days" },
                  { "value": 3, "text": "Nearly every day" }
                ]
              }}},
            { "id": "q_phq9_4", "type": "radio", "prompt": "Feeling tired or having little energy.",
              "properties": { "option_set": {
                "options": [
                  { "value": 0, "text": "Not at all" },
                  { "value": 1, "text": "Several days" },
                  { "value": 2, "text": "More than half the days" },
                  { "value": 3, "text": "Nearly every day" }
                ]
              }}},
            { "id": "q_phq9_5", "type": "radio", "prompt": "Poor appetite or overeating.",
              "properties": { "option_set": {
                "options": [
                  { "value": 0, "text": "Not at all" },
                  { "value": 1, "text": "Several days" },
                  { "value": 2, "text": "More than half the days" },
                  { "value": 3, "text": "Nearly every day" }
                ]
              }}},
            { "id": "q_phq9_6", "type": "radio", "prompt": "Feeling bad about yourself.",
              "properties": { "option_set": {
                "options": [
                  { "value": 0, "text": "Not at all" },
                  { "value": 1, "text": "Several days" },
                  { "value": 2, "text": "More than half the days" },
                  { "value": 3, "text": "Nearly every day" }
                ]
              }}},
            { "id": "q_phq9_7", "type": "radio", "prompt": "Trouble concentrating on things.",
              "properties": { "option_set": {
                "options": [
                  { "value": 0, "text": "Not at all" },
                  { "value": 1, "text": "Several days" },
                  { "value": 2, "text": "More than half the days" },
                  { "value": 3, "text": "Nearly every day" }
                ]
              }}},
            { "id": "q_phq9_8", "type": "radio", "prompt": "Moving or speaking so slowly that other people could have noticed.",
              "properties": { "option_set": {
                "options": [
                  { "value": 0, "text": "Not at all" },
