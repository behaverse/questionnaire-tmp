                  { "value": 0, "text": "Not at all" },
                  { "value": 1, "text": "Several days" },
                  { "value": 2, "text": "More than half the days" },
                  { "value": 3, "text": "Nearly every day" }
                ]
              }}}
          ],
          "style": { "layout": "matrix" }
        }
      ]
