                  { "value": 2, "text": "More than half the days" },
                  { "value": 3, "text": "Nearly every day" }
                ]
              }}},
            { "id": "q_phq9_9", "type": "radio", "prompt": "Thoughts that you would be better off dead, or of hurting yourself.",
