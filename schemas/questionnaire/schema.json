{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://behaverse.org/schemas/questionnaire/v26.0528/schema.json",
  "title": "Questionnaire Definition",
  "description": "Structural specification of a questionnaire. See docs/superpowers/specs/2026-05-28-schemas-1-and-2-design.md §3.",
  "type": "object",
  "required": ["metadata", "pages"],
  "properties": {
    "@context": {
      "type": "string",
      "default": "https://behaverse.org/schemas/questionnaire/context.jsonld"
    },
    "metadata": {
      "allOf": [
        { "$ref": "https://behaverse.org/schemas/instrument/v26.0528/schema.json" },
        {
          "type": "object",
          "properties": {
            "id": { "pattern": "^qst_[a-z0-9_]+$" }
          }
        }
      ]
    },
    "pages": {
      "type": "array",
      "items": { "$ref": "#/$defs/Page" },
      "minItems": 1
    }
  },
  "additionalProperties": false,
  "$defs": {
    "LanguageCode": {
      "type": "string",
      "pattern": "^[a-z]{2,3}(-[A-Z][a-z]{3})?(-[A-Z]{2})?$"
    },
    "Expression": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024,
      "$comment": "Expression grammar defined by the WASM evaluator (OD-11). Schema does not validate grammar."
    },
    "QuestionId": { "type": "string", "pattern": "^q_[a-z0-9_]+$", "maxLength": 64 },
    "OptionSetId": { "type": "string", "pattern": "^os_[a-z0-9_]+$", "maxLength": 64 },
    "PageId":          { "type": "string", "pattern": "^page_[a-z0-9_]+$", "maxLength": 64 },
    "InstructionId":   { "type": "string", "pattern": "^ins_[a-z0-9_]+$",  "maxLength": 64 },
    "PromptId":        { "type": "string", "pattern": "^pr_[a-z0-9_]+$",   "maxLength": 64 },
    "InlineTranslations": {
      "type": "object",
      "patternProperties": {
        "^[a-z]{2,3}(-[A-Z][a-z]{3})?(-[A-Z]{2})?$": {
          "type": "object",
          "required": ["status", "fields"],
          "properties": {
            "status": { "enum": ["draft", "complete", "validated"] },
            "fields": { "type": "object" }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "Page": {
      "type": "object",
      "required": ["id", "entries"],
      "properties": {
        "id":               { "$ref": "#/$defs/PageId" },
        "title":            { "type": "string" },
        "description":      { "type": "string" },
        "entries":          {
          "type": "array",
          "items": { "$ref": "#/$defs/Question" },
          "minItems": 1
        },
        "show_if":          { "$ref": "#/$defs/Expression" },
        "randomize":        { "type": "boolean", "default": false },
        "max_time_seconds": { "type": ["number", "null"], "minimum": 0 },
        "translations":     { "$ref": "#/$defs/InlineTranslations" }
      },
      "additionalProperties": false
    },
    "Question": {
      "oneOf": [
        { "$ref": "#/$defs/QuestionReference" },
        { "$ref": "#/$defs/QuestionRadio" },
        { "$ref": "#/$defs/QuestionCheckbox" },
        { "$ref": "#/$defs/QuestionSlider" },
        { "$ref": "#/$defs/QuestionText" },
        { "$ref": "#/$defs/QuestionTextarea" },
        { "$ref": "#/$defs/QuestionRanking" },
        { "$ref": "#/$defs/QuestionDate" },
        { "$ref": "#/$defs/QuestionFile" },
        { "$ref": "#/$defs/QuestionDisplay" },
        { "$ref": "#/$defs/QuestionExtension" }
      ]
    },
    "QuestionRadio": {
      "type": "object",
      "required": ["id", "type", "prompt", "properties"],
      "properties": {
        "id":         { "$ref": "#/$defs/QuestionId" },
        "type":       { "const": "radio" },
        "prompt":     { "type": "string", "minLength": 1 },
        "required":   { "type": "boolean" },
        "show_if":    { "$ref": "#/$defs/Expression" },
        "tags":       { "type": "array", "items": { "type": "string" } },
        "translations": { "$ref": "#/$defs/InlineTranslations" },
        "properties": { "$ref": "#/$defs/RadioProperties" }
      },
      "additionalProperties": false
    },
    "RadioProperties": {
      "type": "object",
      "required": ["option_set"],
      "properties": {
        "option_set": {
          "oneOf": [
            { "$ref": "#/$defs/OptionSetReference" },
            { "$ref": "#/$defs/OptionSet" }
          ]
        },
        "randomize_options": { "type": "boolean", "default": false }
      },
      "additionalProperties": false
    },
    "OptionSet": {
      "type": "object",
      "required": ["options"],
      "properties": {
        "id":         { "$ref": "#/$defs/OptionSetId" },
        "name":       { "type": "string" },
        "options": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["value", "text"],
            "properties": {
              "value": { "type": ["string", "number", "boolean"] },
              "text":  { "type": "string", "minLength": 1 },
              "icon":  { "type": "string" }
            },
            "additionalProperties": false
          },
          "minItems": 1
        },
        "translations": { "$ref": "#/$defs/InlineTranslations" }
      },
      "additionalProperties": false
    },
    "QuestionReference": {
      "type": "object",
      "required": ["ref"],
      "properties": {
        "ref":      {
          "type": "string",
          "pattern": "^q_[a-z0-9_]+@v\\d{2}\\.\\d{4}(\\.dev\\d+)?$"
        },
        "required": { "type": "boolean" },
        "show_if":  { "$ref": "#/$defs/Expression" }
      },
      "additionalProperties": false
    },
    "OptionSetReference": {
      "type": "object",
      "required": ["ref"],
      "properties": {
        "ref": { "type": "string", "pattern": "^os_[a-z0-9_]+@v\\d{2}\\.\\d{4}(\\.dev\\d+)?$" }
      },
      "additionalProperties": false
    },
    "InstructionReference": {
      "type": "object",
      "required": ["ref"],
      "properties": {
        "ref": { "type": "string", "pattern": "^ins_[a-z0-9_]+@v\\d{2}\\.\\d{4}(\\.dev\\d+)?$" }
      },
      "additionalProperties": false
    },
    "PromptReference": {
      "type": "object",
      "required": ["ref"],
      "properties": {
        "ref": { "type": "string", "pattern": "^pr_[a-z0-9_]+@v\\d{2}\\.\\d{4}(\\.dev\\d+)?$" }
      },
      "additionalProperties": false
    },
    "QuestionText": {
      "type": "object",
      "required": ["id", "type", "prompt"],
      "properties": {
        "id":         { "$ref": "#/$defs/QuestionId" },
        "type":       { "const": "text" },
        "prompt":     { "type": "string", "minLength": 1 },
        "required":   { "type": "boolean" },
        "show_if":    { "$ref": "#/$defs/Expression" },
        "tags":       { "type": "array", "items": { "type": "string" } },
        "translations": { "$ref": "#/$defs/InlineTranslations" },
        "properties": {
          "type": "object",
          "properties": {
            "placeholder": { "type": "string" },
            "default":     { "type": "string" }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "QuestionTextarea": {
      "type": "object",
      "required": ["id", "type", "prompt"],
      "properties": {
        "id":         { "$ref": "#/$defs/QuestionId" },
        "type":       { "const": "textarea" },
        "prompt":     { "type": "string", "minLength": 1 },
        "required":   { "type": "boolean" },
        "show_if":    { "$ref": "#/$defs/Expression" },
        "tags":       { "type": "array", "items": { "type": "string" } },
        "translations": { "$ref": "#/$defs/InlineTranslations" },
        "properties": {
          "type": "object",
          "properties": {
            "rows":        { "type": "integer", "minimum": 1, "maximum": 50 },
            "placeholder": { "type": "string" }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "QuestionCheckbox": {
      "type": "object",
      "required": ["id", "type", "prompt", "properties"],
      "properties": {
        "id":         { "$ref": "#/$defs/QuestionId" },
        "type":       { "const": "checkbox" },
        "prompt":     { "type": "string", "minLength": 1 },
        "required":   { "type": "boolean" },
        "show_if":    { "$ref": "#/$defs/Expression" },
        "tags":       { "type": "array", "items": { "type": "string" } },
        "translations": { "$ref": "#/$defs/InlineTranslations" },
        "properties": {
          "type": "object",
          "required": ["option_set"],
          "properties": {
            "option_set": {
              "oneOf": [
                { "$ref": "#/$defs/OptionSetReference" },
                { "$ref": "#/$defs/OptionSet" }
              ]
            },
            "min_selected":       { "type": "integer", "minimum": 0 },
            "max_selected":       { "type": "integer", "minimum": 1 },
            "randomize_options":  { "type": "boolean", "default": false }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "QuestionSlider": {
      "type": "object",
      "required": ["id", "type", "prompt", "properties"],
      "properties": {
        "id":         { "$ref": "#/$defs/QuestionId" },
        "type":       { "const": "slider" },
        "prompt":     { "type": "string", "minLength": 1 },
        "required":   { "type": "boolean" },
        "show_if":    { "$ref": "#/$defs/Expression" },
        "tags":       { "type": "array", "items": { "type": "string" } },
        "translations": { "$ref": "#/$defs/InlineTranslations" },
        "properties": {
          "type": "object",
          "required": ["min", "max"],
          "properties": {
            "min":     { "type": "number" },
            "max":     { "type": "number" },
            "step":    { "type": "number", "exclusiveMinimum": 0 },
            "default": { "type": "number" },
            "anchors": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["value", "label"],
                "properties": {
                  "value": { "type": "number" },
                  "label": { "type": "string" }
                },
                "additionalProperties": false
              }
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "QuestionRanking": {
      "type": "object",
      "required": ["id", "type", "prompt", "properties"],
      "properties": {
        "id":         { "$ref": "#/$defs/QuestionId" },
        "type":       { "const": "ranking" },
        "prompt":     { "type": "string", "minLength": 1 },
        "required":   { "type": "boolean" },
        "show_if":    { "$ref": "#/$defs/Expression" },
        "tags":       { "type": "array", "items": { "type": "string" } },
        "translations": { "$ref": "#/$defs/InlineTranslations" },
        "properties": {
          "type": "object",
          "required": ["option_set"],
          "properties": {
            "option_set": {
              "oneOf": [
                { "$ref": "#/$defs/OptionSetReference" },
                { "$ref": "#/$defs/OptionSet" }
              ]
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "QuestionDate": {
      "type": "object",
      "required": ["id", "type", "prompt"],
      "properties": {
        "id":         { "$ref": "#/$defs/QuestionId" },
        "type":       { "const": "date" },
        "prompt":     { "type": "string", "minLength": 1 },
        "required":   { "type": "boolean" },
        "show_if":    { "$ref": "#/$defs/Expression" },
        "tags":       { "type": "array", "items": { "type": "string" } },
        "translations": { "$ref": "#/$defs/InlineTranslations" },
        "properties": {
          "type": "object",
          "properties": {
            "granularity": { "enum": ["date", "datetime", "time", "month", "year"] },
            "min":         { "type": "string" },
            "max":         { "type": "string" }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "QuestionFile": {
      "type": "object",
      "required": ["id", "type", "prompt"],
      "properties": {
        "id":         { "$ref": "#/$defs/QuestionId" },
        "type":       { "const": "file" },
        "prompt":     { "type": "string", "minLength": 1 },
        "required":   { "type": "boolean" },
        "show_if":    { "$ref": "#/$defs/Expression" },
        "tags":       { "type": "array", "items": { "type": "string" } },
        "translations": { "$ref": "#/$defs/InlineTranslations" },
        "properties": {
          "type": "object",
          "properties": {
            "accept":      { "type": "array", "items": { "type": "string" } },
            "max_size_mb": { "type": "number", "exclusiveMinimum": 0 },
            "multiple":    { "type": "boolean" }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "QuestionDisplay": {
      "type": "object",
      "required": ["id", "type", "prompt"],
      "properties": {
        "id":         { "$ref": "#/$defs/QuestionId" },
        "type":       { "const": "display" },
        "prompt":     { "type": "string", "minLength": 1 },
        "show_if":    { "$ref": "#/$defs/Expression" },
        "tags":       { "type": "array", "items": { "type": "string" } },
        "translations": { "$ref": "#/$defs/InlineTranslations" },
        "properties": {
          "type": "object",
          "properties": {
            "media": {
              "type": "object",
              "required": ["url", "kind"],
              "properties": {
                "url":  { "type": "string", "format": "uri" },
                "kind": { "enum": ["image", "audio", "video"] }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "QuestionExtension": {
      "type": "object",
      "required": ["id", "type", "prompt"],
      "properties": {
        "id":         { "$ref": "#/$defs/QuestionId" },
        "type":       {
          "type": "string",
          "pattern": "^https://behaverse\\.org/types/[a-z0-9_]+$"
        },
        "prompt":     { "type": "string" },
        "required":   { "type": "boolean" },
        "show_if":    { "$ref": "#/$defs/Expression" },
        "tags":       { "type": "array", "items": { "type": "string" } },
        "translations": { "$ref": "#/$defs/InlineTranslations" },
        "properties": { "type": "object" }
      },
      "additionalProperties": false
    }
  }
}
