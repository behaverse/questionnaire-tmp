{
  "@context": {
    "@vocab":        "https://behaverse.org/schemas/response#",
    "bdm":           "https://behaverse.org/data-model#",
    "schema":        "http://schema.org/",
    "dc":            "http://purl.org/dc/terms/",

    "response_id":           { "@id": "bdm:response_id" },
    "study_name":            { "@id": "bdm:study_name" },
    "group_name":            { "@id": "bdm:group_name" },
    "agent_id":              { "@id": "bdm:agent_id" },
    "session_index":         { "@id": "bdm:session_index" },
    "session_id":            { "@id": "bdm:session_id", "@type": "@id" },
    "activity_index":        { "@id": "bdm:activity_index" },
    "language":              { "@id": "bdm:language" },
    "instrument_id":         { "@id": "bdm:instrument_id", "@type": "@id" },
    "instrument_repetition": { "@id": "bdm:instrument_repetition" },
    "timeline_id":           { "@id": "bdm:timeline_id" },
    "timeline_repetition":   { "@id": "bdm:timeline_repetition" },
    "multitask_type":        { "@id": "bdm:multitask_type" },
    "task_index":            { "@id": "bdm:task_index" },
    "job_type":              { "@id": "bdm:job_type" },
    "job_description":       { "@id": "bdm:job_description" },
    "job_repeat":            { "@id": "bdm:job_repeat" },
    "block_index":           { "@id": "bdm:block_index" },
    "block_name":            { "@id": "bdm:block_name" },
    "block_type":            { "@id": "bdm:block_type" },
    "transformation_name":   { "@id": "bdm:transformation_name" },
    "trial_index":           { "@id": "bdm:trial_index" },
    "episode_index":         { "@id": "bdm:episode_index" },
    "trial_start_datetime":  { "@id": "bdm:trial_start_datetime" },
    "trial_seed":            { "@id": "bdm:trial_seed" },
    "stimulus_index":        { "@id": "bdm:stimulus_index" },
    "stimulus_id":           { "@id": "bdm:stimulus_id" },
    "stimulus_type":         { "@id": "bdm:stimulus_type" },
    "stimulus_description":  { "@id": "bdm:stimulus_description" },
    "option_id":             { "@id": "bdm:option_id" },
    "option_data_type":      { "@id": "bdm:option_data_type" },
    "measurement_type":      { "@id": "bdm:measurement_type" },
    "response_option_index": { "@id": "bdm:response_option_index" },
    "response_description":  { "@id": "bdm:response_description" },
    "response_numeric":      { "@id": "bdm:response_numeric" },
    "response_time":         { "@id": "bdm:response_time" },
    "correct":               { "@id": "bdm:correct" },
    "score":                 { "@id": "bdm:score" },
    "additional_measures":   { "@id": "bdm:additional_measures" },

    "responses":             { "@id": "https://behaverse.org/schemas/response#responses", "@container": "@list" }
  }
}
