DATABASE_URL=postgresql://postgres:postgres@localhost:5432/identity_service
IDENTITY_ISSUER=http://localhost:8100
IDENTITY_CORS_ORIGINS=http://localhost:5173,http://localhost:5174
WEB_VIEWER_BASE_URL=http://localhost:5173
# Role granted to a NEW self-registered account. Keep `participant` — a privileged default
# (researcher/reviewer/administrator) lets anyone self-mint a privileged token. Elevate a user
# with POST /v1/admin/users/{id}/roles or the `identity create-admin` CLI.
DEFAULT_REGISTER_ROLE=participant
# token TTLs (seconds) — defaults shown
# ACCESS_TOKEN_TTL=900
# REFRESH_TOKEN_TTL=2592000
# VERIFY_TOKEN_TTL=86400
# RESET_TOKEN_TTL=3600
# HANDOFF_TTL=60
# email: set RESEND_API_KEY for real sends; otherwise links are logged to the console
RESEND_API_KEY=
SMTP_FROM=no-reply@behaverse.org
# SMTP alternative to Resend (used only if RESEND_API_KEY is unset and SMTP_HOST is set):
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# cron trigger guard (fail-closed when unset)
CRON_SECRET=dev-cron-secret
