{
  "id": "scr_hai18",
  "name": "HAI-18 Total Scoring",
  "content": {
    "en": {
      "status": "validated",
      "name": "HAI-18 Total Scoring",
      "description": "Short Health Anxiety Inventory (HAI-18). Total = sum of the 18 items (each 0-3, range 0-54); higher = greater health anxiety (reverse-keyed items reversed by the runtime). No standard cut-offs."
    }
  },
  "x_publication": {
    "citation": "P M Salkovskis, K A Rimes, H MC Warwick, D M Clark. The Health Anxiety Inventory: development and validation of scales for the measurement of health anxiety and hypochondriasis. Psychol Med. 2006; 32 ( 5 ): 843–853.",
    "year": 2006
  },
  "inputs": {
    "type": "object",
    "properties": {
      "scored_responses": {
        "type": "object",
        "patternProperties": {
          "^(pr_hai18_1|pr_hai18_2|pr_hai18_3|pr_hai18_4|pr_hai18_5|pr_hai18_6|pr_hai18_7|pr_hai18_8|pr_hai18_9|pr_hai18_10|pr_hai18_11|pr_hai18_12|pr_hai18_13|pr_hai18_14|pr_hai18_15|pr_hai18_16|pr_hai18_17|pr_hai18_18)$": {
            "type": "integer",
            "minimum": 0,
            "maximum": 3
          }
        }
      }
    },
    "required": [
      "scored_responses"
    ]
  },
  "output_schema": {
    "type": "object",
    "properties": {
      "scores": {
        "type": "object",
        "properties": {
          "total": {
            "type": "object",
