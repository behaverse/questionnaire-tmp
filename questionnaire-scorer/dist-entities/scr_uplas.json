{
  "id": "scr_uplas",
  "name": "UPLAS Total Scoring",
  "content": {
    "en": {
      "status": "validated",
      "name": "UPLAS Total Scoring",
      "description": "Loneliness (UPLAS). Total = sum of the 25 items (each 1-4), range 25-100. Higher scores indicate greater loneliness (reverse-keyed items are reversed by the runtime). No standard severity cut-offs."
    }
  },
  "x_publication": {
    "citation": "Tharayil, D.P. (2012). Developing the University of the Philippines\nLoneliness Assessment Scale: A Cross-Cultural Measurement. Social\nIndicators Research, 106 (2) , 307-321.",
    "year": 2012
  },
  "inputs": {
    "type": "object",
    "properties": {
      "scored_responses": {
        "type": "object",
        "patternProperties": {
          "^(pr_uplas_1|pr_uplas_2|pr_uplas_3|pr_uplas_4|pr_uplas_5|pr_uplas_6|pr_uplas_7|pr_uplas_8|pr_uplas_9|pr_uplas_10|pr_uplas_11|pr_uplas_12|pr_uplas_13|pr_uplas_14|pr_uplas_15|pr_uplas_16|pr_uplas_17|pr_uplas_18|pr_uplas_19|pr_uplas_20|pr_uplas_21|pr_uplas_22|pr_uplas_23|pr_uplas_24|pr_uplas_25)$": {
            "type": "integer",
            "minimum": 1,
            "maximum": 4
          }
        }
      }
    },
    "required": [
      "scored_responses"
    ]
  },
  "output_schema": {
    "type": "object",
    "properties": {
      "scores": {
        "type": "object",
        "properties": {
          "total": {
            "type": "object",
            "properties": {
              "value": {
                "type": "number"
              }
            },
            "required": [
              "value"
            ]
          }
        },
        "required": [
          "total"
        ]
      },
      "missing_count": {
        "type": "integer",
        "minimum": 0
      }
    },
    "required": [
      "scores",
      "missing_count"
    ]
  },
  "implementations": [
