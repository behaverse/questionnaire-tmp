{
  "id": "scr_piuq",
  "name": "PIUQ Total Scoring",
  "content": {
    "en": {
      "status": "validated",
      "name": "PIUQ Total Scoring",
      "description": "Problematic Internet Use Questionnaire (PIUQ). Total = sum of the 18 items (each 1-5), range 18-90; higher = greater problematic internet use (reverse-keyed items reversed by the runtime). No standard cut-offs."
    }
  },
  "x_publication": {
    "citation": "Demetrovics, Z., Szeredi, B., & Rózsa, S. (2008). The three-factor model of Internet addiction: The development of the Problematic Internet Use Questionnaire. Behavior Research Methods, 40 , 563-574.",
    "year": 2008
  },
  "inputs": {
    "type": "object",
    "properties": {
      "scored_responses": {
        "type": "object",
        "patternProperties": {
          "^(pr_piuq_1|pr_piuq_2|pr_piuq_3|pr_piuq_4|pr_piuq_5|pr_piuq_6|pr_piuq_7|pr_piuq_8|pr_piuq_9|pr_piuq_10|pr_piuq_11|pr_piuq_12|pr_piuq_13|pr_piuq_14|pr_piuq_15|pr_piuq_16|pr_piuq_17|pr_piuq_18)$": {
            "type": "integer",
            "minimum": 1,
            "maximum": 5
          }
        }
      }
    },
    "required": [
      "scored_responses"
    ]
  },
  "output_schema": {
    "type": "object",
    "properties": {
      "scores": {
        "type": "object",
        "properties": {
          "total": {
            "type": "object",
            "properties": {
              "value": {
                "type": "number"
              }
            },
            "required": [
              "value"
            ]
          }
        },
        "required": [
          "total"
        ]
      },
      "missing_count": {
        "type": "integer",
        "minimum": 0
      }
    },
    "required": [
      "scores",
      "missing_count"
    ]
  },
  "implementations": [
    {
      "kind": "wasm",
      "url": "https://behaverse.org/scorers/piuq/scorer.wasm",
      "sha256": "e48684ca430c62589cbae3667a5731e70044098ce835f0ae9f44306ccc9c3d5b"
    }
  ],
