{
  "id": "scr_swls",
  "name": "SWLS Standard Scoring",
  "content": {
    "en": {
      "status": "validated",
      "name": "SWLS Standard Scoring",
      "description": "Satisfaction With Life Scale (Diener et al., 1985). Total = sum of the 5 items (each 1-7), range 5-35. Interpretation bands: 31-35 extremely satisfied, 26-30 satisfied, 21-25 slightly satisfied, 20 neutral, 15-19 slightly dissatisfied, 10-14 dissatisfied, 5-9 extremely dissatisfied."
    }
  },
  "x_publication": {
    "citation": "Diener E, Emmons RA, Larsen RJ, Griffin S (1985). The Satisfaction with Life Scale. J Pers Assess, 49(1), 71-75.",
    "year": 1985
  },
  "inputs": {
    "type": "object",
    "properties": {
      "scored_responses": {
        "type": "object",
        "patternProperties": {
          "^(pr_swls_1|pr_swls_2|pr_swls_3|pr_swls_4|pr_swls_5)$": {
            "type": "integer",
            "minimum": 1,
            "maximum": 7
          }
        }
      }
    },
    "required": [
      "scored_responses"
    ]
  },
  "output_schema": {
    "type": "object",
    "properties": {
      "scores": {
        "type": "object",
        "properties": {
          "total": {
            "type": "object",
            "properties": {
              "value": {
                "type": "number"
              },
              "severity": {
                "type": "string",
                "enum": [
                  "extremely_dissatisfied",
                  "dissatisfied",
                  "slightly_dissatisfied",
                  "neutral",
                  "slightly_satisfied",
                  "satisfied",
                  "extremely_satisfied"
                ]
              },
              "band": {
                "type": "object",
                "properties": {
                  "min": {
                    "type": "number"
                  },
                  "max": {
                    "type": "number"
                  },
                  "label": {
                    "type": "string"
                  }
                },
                "required": [
                  "min",
                  "max",
                  "label"
                ]
              }
            },
            "required": [
              "value"
            ]
          }
        },
        "required": [
          "total"
        ]
      },
      "missing_count": {
        "type": "integer",
        "minimum": 0
      }
    },
    "required": [
      "scores",
      "missing_count"
    ]
  },
  "implementations": [
    {
      "kind": "wasm",
      "url": "https://behaverse.org/scorers/swls/scorer.wasm",
      "sha256": "d2e0d5d79b0146fce7bd87e24fcfe169b5ff70be00a33f2fcdf7edde212bc5f3"
    }
  ],
  "test_cases": [
    {
      "name": "extremely-satisfied-ceiling",
      "input": {
        "scored_responses": {
          "pr_swls_1": 7,
          "pr_swls_2": 7,
          "pr_swls_3": 7,
          "pr_swls_4": 7,
          "pr_swls_5": 7
        }
      },
      "expected": {
        "scores": {
          "total": {
            "value": 35,
            "severity": "extremely_satisfied",
            "band": {
              "min": 31,
              "max": 35,
              "label": "Extremely satisfied"
            }
          }
        },
        "missing_count": 0
      }
    },
    {
      "name": "neutral-exact",
      "input": {
        "scored_responses": {
          "pr_swls_1": 5,
          "pr_swls_2": 5,
          "pr_swls_3": 4,
          "pr_swls_4": 4,
          "pr_swls_5": 2
        }
      },
      "expected": {
        "scores": {
          "total": {
            "value": 20,
            "severity": "neutral",
            "band": {
              "min": 20,
              "max": 20,
              "label": "Neutral"
            }
          }
        },
        "missing_count": 0
      }
    },
    {
      "name": "extremely-dissatisfied-floor",
      "input": {
        "scored_responses": {
          "pr_swls_1": 1,
          "pr_swls_2": 1,
          "pr_swls_3": 1,
          "pr_swls_4": 1,
          "pr_swls_5": 1
        }
      },
      "expected": {
        "scores": {
          "total": {
            "value": 5,
            "severity": "extremely_dissatisfied",
            "band": {
              "min": 5,
              "max": 9,
              "label": "Extremely dissatisfied"
            }
          }
        },
        "missing_count": 0
      }
    }
  ]
}
