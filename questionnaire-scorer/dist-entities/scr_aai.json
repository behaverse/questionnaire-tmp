{
  "id": "scr_aai",
  "name": "AAI Total Scoring",
  "content": {
    "en": {
      "status": "validated",
      "name": "AAI Total Scoring",
      "description": "Appearance Anxiety Inventory (AAI). Total = sum of the 10 items (each 0-4), range 0-40. Higher scores indicate greater appearance anxiety (reverse-keyed items are reversed by the runtime). No standard severity cut-offs."
    }
  },
  "x_publication": {
    "citation": "Veale, D., Eshkevaria, E., Kanakama, N., Ellisona, N., Costa, A., and\nWerner, T. (2014). The Appearance Anxiety Inventory: Validation of a\nProcess Measure in the Treatment of Body Dysmorphic\nDisorder. Behavioural and Cognitive Psychotherapy, 42 , 605-616. Link to publisher",
    "year": 2014
  },
  "inputs": {
    "type": "object",
    "properties": {
      "scored_responses": {
        "type": "object",
        "patternProperties": {
          "^(pr_aai_1|pr_aai_2|pr_aai_3|pr_aai_4|pr_aai_5|pr_aai_6|pr_aai_7|pr_aai_8|pr_aai_9|pr_aai_10)$": {
            "type": "integer",
            "minimum": 0,
            "maximum": 4
          }
        }
      }
    },
    "required": [
      "scored_responses"
    ]
  },
  "output_schema": {
    "type": "object",
    "properties": {
      "scores": {
        "type": "object",
        "properties": {
          "total": {
            "type": "object",
            "properties": {
              "value": {
                "type": "number"
              }
            },
            "required": [
              "value"
            ]
          }
        },
        "required": [
          "total"
        ]
      },
      "missing_count": {
        "type": "integer",
        "minimum": 0
      }
    },
    "required": [
      "scores",
      "missing_count"
    ]
  },
  "implementations": [
    {
      "kind": "wasm",
      "url": "https://behaverse.org/scorers/aai/scorer.wasm",
      "sha256": "47188579c1f51124a3b14ad2872095d687471e429453cf76bcfbe08b72668b31"
    }
  ],
  "test_cases": [
    {
