        "scored_responses": {
          "pr_aai_1": 0,
          "pr_aai_2": 0,
          "pr_aai_3": 0,
          "pr_aai_4": 0,
          "pr_aai_5": 0,
          "pr_aai_6": 0,
          "pr_aai_7": 0,
          "pr_aai_8": 0,
          "pr_aai_9": 0,
          "pr_aai_10": 0
        }
      },
      "expected": {
        "scores": {
