{
  "id": "scr_besc",
  "name": "BES Total Scoring",
  "content": {
    "en": {
      "status": "validated",
      "name": "BES Total Scoring",
      "description": "Belonging, engagement, and self-confidence in higher education (BES). Total = sum of the 16 items (each 1-5), range 16-80; higher = greater belonging, engagement and self-confidence in higher education (reverse-keyed items reversed by the runtime). No standard cut-offs."
    }
  },
  "x_publication": {
    "citation": "Yorke, M. (2016). The development and initial use of a survey of student ‘belongingness’, engagement and self-confidence in UK higher education. Assessment & Evaluation in Higher Education, 41(1) , 154-166, DOI: 10.1080/02602938.2014.990415. Open access link .",
    "year": 2016
  },
  "inputs": {
    "type": "object",
    "properties": {
      "scored_responses": {
        "type": "object",
        "patternProperties": {
          "^(pr_besc_1|pr_besc_2|pr_besc_3|pr_besc_4|pr_besc_5|pr_besc_6|pr_besc_7|pr_besc_8|pr_besc_9|pr_besc_10|pr_besc_11|pr_besc_12|pr_besc_13|pr_besc_14|pr_besc_15|pr_besc_16)$": {
            "type": "integer",
            "minimum": 1,
            "maximum": 5
          }
        }
      }
    },
    "required": [
      "scored_responses"
    ]
  },
  "output_schema": {
    "type": "object",
    "properties": {
      "scores": {
        "type": "object",
        "properties": {
          "total": {
            "type": "object",
            "properties": {
              "value": {
                "type": "number"
              }
            },
            "required": [
              "value"
            ]
          }
        },
        "required": [
          "total"
        ]
      },
      "missing_count": {
        "type": "integer",
        "minimum": 0
      }
    },
    "required": [
      "scores",
      "missing_count"
    ]
  },
  "implementations": [
