{
  "id": "scr_sas",
  "name": "SAS Scoring",
  "content": {
    "en": {
      "status": "validated",
      "name": "SAS Scoring",
      "description": "Zung Self-Rating Anxiety Scale. Raw = sum of the 20 items (each 1-4; reverse items pre-scored), range 20-80; the SAS index = raw x 1.25 (range 25-100). Bands: <45 normal, 45-59 mild-moderate, 60-74 marked-severe, 75+ extreme."
    }
  },
  "x_publication": {
    "citation": "William W K Zung. A Rating Instrument for Anxiety Disorders. 12 ( 6 ): Psychosomatics 371-379. 1971.",
    "year": 1971
  },
  "inputs": {
    "type": "object",
    "properties": {
      "scored_responses": {
        "type": "object",
        "patternProperties": {
          "^(pr_sas_1|pr_sas_2|pr_sas_3|pr_sas_4|pr_sas_5|pr_sas_6|pr_sas_7|pr_sas_8|pr_sas_9|pr_sas_10|pr_sas_11|pr_sas_12|pr_sas_13|pr_sas_14|pr_sas_15|pr_sas_16|pr_sas_17|pr_sas_18|pr_sas_19|pr_sas_20)$": {
            "type": "integer",
            "minimum": 1,
            "maximum": 4
          }
        }
      }
    },
    "required": [
      "scored_responses"
    ]
  },
  "output_schema": {
    "type": "object",
    "properties": {
      "scores": {
        "type": "object",
        "properties": {
          "index": {
            "type": "object",
            "properties": {
              "value": {
                "type": "number"
              },
              "severity": {
                "type": "string",
                "enum": [
                  "normal",
                  "mild_moderate",
                  "marked_severe",
                  "extreme"
                ]
              },
              "band": {
                "type": "object",
                "properties": {
                  "min": {
                    "type": "number"
                  },
                  "max": {
                    "type": "number"
                  },
                  "label": {
                    "type": "string"
                  }
                },
                "required": [
                  "min",
                  "max",
                  "label"
                ]
              }
            },
            "required": [
              "value"
            ]
          }
        },
        "required": [
          "index"
        ]
      },
      "missing_count": {
        "type": "integer",
        "minimum": 0
      }
    },
    "required": [
      "scores",
      "missing_count"
    ]
  },
  "implementations": [
    {
      "kind": "wasm",
      "url": "https://behaverse.org/scorers/sas/scorer.wasm",
      "sha256": "a7f38d7b7a95e1f3bec1dad92f10a4898bf8b1421daef47d605c455d59d93621"
    }
  ],
