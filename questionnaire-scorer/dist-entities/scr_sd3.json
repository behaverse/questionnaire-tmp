{
  "id": "scr_sd3",
  "name": "SD3 Scoring",
  "content": {
    "en": {
      "status": "validated",
      "name": "SD3 Scoring",
      "description": "A brief measure of dark personality traits (SD3). Short Dark Triad (Jones & Paulhus, 2014). Three subscale MEAN scores (each 9 items, 1-5; reverse-keyed items reversed by the runtime): Machiavellianism (items 1-9), Narcissism (10-18), Psychopathy (19-27). Higher = stronger trait; no severity cut-offs."
    }
  },
  "x_publication": {
    "citation": "Jones, D. N., & Paulhus, D. L. (2014).  Introducing the Short Dark Triad (SD3): A brief measure of dark personality traits.  Assessment, 21,  28-41.",
    "year": 2014
  },
  "inputs": {
    "type": "object",
    "properties": {
      "scored_responses": {
        "type": "object",
        "patternProperties": {
          "^(pr_sd3_1|pr_sd3_2|pr_sd3_3|pr_sd3_4|pr_sd3_5|pr_sd3_6|pr_sd3_7|pr_sd3_8|pr_sd3_9|pr_sd3_10|pr_sd3_11|pr_sd3_12|pr_sd3_13|pr_sd3_14|pr_sd3_15|pr_sd3_16|pr_sd3_17|pr_sd3_18|pr_sd3_19|pr_sd3_20|pr_sd3_21|pr_sd3_22|pr_sd3_23|pr_sd3_24|pr_sd3_25|pr_sd3_26|pr_sd3_27)$": {
            "type": "integer",
            "minimum": 1,
            "maximum": 5
          }
        }
      }
    },
    "required": [
      "scored_responses"
    ]
  },
  "output_schema": {
    "type": "object",
    "properties": {
      "scores": {
        "type": "object",
        "properties": {
          "machiavellianism": {
            "type": "object",
            "properties": {
              "value": {
                "type": "number"
              }
            },
            "required": [
              "value"
            ]
          },
          "narcissism": {
            "type": "object",
            "properties": {
              "value": {
                "type": "number"
              }
            },
            "required": [
              "value"
            ]
          },
          "psychopathy": {
            "type": "object",
            "properties": {
              "value": {
                "type": "number"
              }
            },
            "required": [
              "value"
            ]
          }
        },
        "required": [
          "machiavellianism",
          "narcissism",
          "psychopathy"
        ]
      },
      "missing_count": {
        "type": "integer",
        "minimum": 0
      }
    },
    "required": [
      "scores",
      "missing_count"
    ]
  },
  "implementations": [
