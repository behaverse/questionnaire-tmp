{
  "id": "scr_desii",
  "name": "DES-II Scoring",
  "content": {
    "en": {
      "status": "validated",
      "name": "DES-II Scoring",
      "description": "Dissociative Experiences Scale (DES-II). Dissociative Experiences Scale-II (Carlson & Putnam, 1993). Score = MEAN of the 28 items (each 0-10, i.e. 0-100% in 10s) x10, range 0-100; a mean of 30 or more warrants screening for a dissociative disorder."
    }
  },
  "x_publication": {
    "citation": "Carlson E B, Putnam F W. An update on the Dissociative Experience Scale. Dissociation 6 ( 1 ): 16-27 ( 1993 ).",
    "year": 1993
  },
  "inputs": {
    "type": "object",
    "properties": {
      "scored_responses": {
        "type": "object",
        "patternProperties": {
          "^(pr_desii_1|pr_desii_2|pr_desii_3|pr_desii_4|pr_desii_5|pr_desii_6|pr_desii_7|pr_desii_8|pr_desii_9|pr_desii_10|pr_desii_11|pr_desii_12|pr_desii_13|pr_desii_14|pr_desii_15|pr_desii_16|pr_desii_17|pr_desii_18|pr_desii_19|pr_desii_20|pr_desii_21|pr_desii_22|pr_desii_23|pr_desii_24|pr_desii_25|pr_desii_26|pr_desii_27|pr_desii_28)$": {
            "type": "integer",
            "minimum": 0,
            "maximum": 10
          }
        }
      }
    },
    "required": [
      "scored_responses"
    ]
  },
  "output_schema": {
    "type": "object",
    "properties": {
      "scores": {
        "type": "object",
        "properties": {
          "dissociation": {
            "type": "object",
            "properties": {
              "value": {
                "type": "number"
              },
              "severity": {
                "type": "string",
                "enum": [
                  "below_taxon",
                  "elevated"
                ]
              },
              "band": {
                "type": "object",
                "properties": {
                  "min": {
                    "type": "number"
                  },
                  "max": {
                    "type": "number"
                  },
                  "label": {
                    "type": "string"
                  }
                },
                "required": [
                  "min",
                  "max",
                  "label"
                ]
              }
            },
            "required": [
              "value"
            ]
          }
        },
        "required": [
          "dissociation"
        ]
      },
      "missing_count": {
        "type": "integer",
        "minimum": 0
      }
    },
    "required": [
      "scores",
      "missing_count"
    ]
  },
  "implementations": [
    {
      "kind": "wasm",
      "url": "https://behaverse.org/scorers/desii/scorer.wasm",
