{
  "id": "scr_bis",
  "name": "BIS Total Scoring",
  "content": {
    "en": {
      "status": "validated",
      "name": "BIS Total Scoring",
      "description": "Barratt’s Impulsiveness scale (BIS). Total = sum of the 30 items (each 1-4), range 30-120; higher = greater impulsiveness (reverse-keyed items reversed by the runtime). No standard cut-offs."
    }
  },
  "inputs": {
    "type": "object",
    "properties": {
      "scored_responses": {
        "type": "object",
        "patternProperties": {
          "^(pr_bis_1|pr_bis_2|pr_bis_3|pr_bis_4|pr_bis_5|pr_bis_6|pr_bis_7|pr_bis_8|pr_bis_9|pr_bis_10|pr_bis_11|pr_bis_12|pr_bis_13|pr_bis_14|pr_bis_15|pr_bis_16|pr_bis_17|pr_bis_18|pr_bis_19|pr_bis_20|pr_bis_21|pr_bis_22|pr_bis_23|pr_bis_24|pr_bis_25|pr_bis_26|pr_bis_27|pr_bis_28|pr_bis_29|pr_bis_30)$": {
            "type": "integer",
            "minimum": 1,
            "maximum": 4
          }
        }
      }
    },
    "required": [
      "scored_responses"
    ]
  },
  "output_schema": {
    "type": "object",
    "properties": {
      "scores": {
        "type": "object",
        "properties": {
          "total": {
            "type": "object",
            "properties": {
              "value": {
                "type": "number"
              }
            },
            "required": [
              "value"
            ]
          }
        },
        "required": [
          "total"
        ]
      },
      "missing_count": {
        "type": "integer",
        "minimum": 0
      }
    },
    "required": [
      "scores",
      "missing_count"
    ]
  },
  "implementations": [
    {
      "kind": "wasm",
      "url": "https://behaverse.org/scorers/bis/scorer.wasm",
      "sha256": "8f1011981426e52c967b8102c88142d45d02153988ae3b558c9062277cdb7963"
    }
  ],
