{
  "id": "scr_sds",
  "name": "SDS Scoring",
  "content": {
    "en": {
      "status": "validated",
      "name": "SDS Scoring",
      "description": "Zung Self-Rating Depression Scale. Raw = sum of the 20 items (each 1-4; reverse items pre-scored), range 20-80; the SDS index = raw x 1.25 (range 25-100). Bands: <50 normal, 50-59 mild, 60-69 moderate, 70+ severe."
    }
  },
  "x_publication": {
    "citation": "William W K Zung. A Self-Rating Depression Scale. 12: Arch Gen Psychiatry 63-70. 1965.",
    "year": 1965
  },
  "inputs": {
    "type": "object",
    "properties": {
      "scored_responses": {
        "type": "object",
        "patternProperties": {
          "^(pr_sds_1|pr_sds_2|pr_sds_3|pr_sds_4|pr_sds_5|pr_sds_6|pr_sds_7|pr_sds_8|pr_sds_9|pr_sds_10|pr_sds_11|pr_sds_12|pr_sds_13|pr_sds_14|pr_sds_15|pr_sds_16|pr_sds_17|pr_sds_18|pr_sds_19|pr_sds_20)$": {
            "type": "integer",
            "minimum": 1,
            "maximum": 4
          }
        }
      }
    },
    "required": [
      "scored_responses"
    ]
  },
  "output_schema": {
    "type": "object",
    "properties": {
      "scores": {
        "type": "object",
        "properties": {
          "index": {
            "type": "object",
            "properties": {
              "value": {
                "type": "number"
              },
              "severity": {
                "type": "string",
                "enum": [
                  "normal",
                  "mild",
                  "moderate",
                  "severe"
                ]
              },
              "band": {
                "type": "object",
                "properties": {
                  "min": {
                    "type": "number"
                  },
                  "max": {
                    "type": "number"
                  },
                  "label": {
                    "type": "string"
                  }
                },
                "required": [
                  "min",
                  "max",
                  "label"
                ]
              }
            },
            "required": [
              "value"
            ]
          }
        },
        "required": [
          "index"
        ]
      },
      "missing_count": {
        "type": "integer",
        "minimum": 0
      }
    },
    "required": [
      "scores",
      "missing_count"
    ]
  },
  "implementations": [
    {
      "kind": "wasm",
      "url": "https://behaverse.org/scorers/sds/scorer.wasm",
      "sha256": "2f59400d097341a7354237b36c21bbe1c342e9f02292875ed02949040064d20f"
    }
  ],
