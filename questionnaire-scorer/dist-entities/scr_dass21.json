    "type": "object",
    "properties": {
      "scored_responses": {
        "type": "object",
        "patternProperties": {
          "^(pr_dass21_3|pr_dass21_5|pr_dass21_10|pr_dass21_13|pr_dass21_16|pr_dass21_17|pr_dass21_21|pr_dass21_2|pr_dass21_4|pr_dass21_7|pr_dass21_9|pr_dass21_15|pr_dass21_19|pr_dass21_20|pr_dass21_1|pr_dass21_6|pr_dass21_8|pr_dass21_11|pr_dass21_12|pr_dass21_14|pr_dass21_18)$": {
