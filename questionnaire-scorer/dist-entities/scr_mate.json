{
  "id": "scr_mate",
  "name": "MATE Total Scoring",
  "content": {
    "en": {
      "status": "validated",
      "name": "MATE Total Scoring",
      "description": "Measure of Acceptance of the Theory of Evolution (MATE). Total = sum of the 20 items (each 1-5), range 20-100. Higher scores indicate greater acceptance of the theory of evolution (reverse-keyed items are reversed by the runtime). No standard severity cut-offs."
    }
  },
  "x_publication": {
    "citation": "Rutledge, M .L . & Warden, M .A . (1999). The development and validation of the Measure of Acceptance of the Theory of Evolution Instrument. School Science and Mathematics, 99(1) , 13-18.",
    "year": 1999
  },
  "inputs": {
    "type": "object",
    "properties": {
      "scored_responses": {
        "type": "object",
        "patternProperties": {
          "^(pr_mate_1|pr_mate_2|pr_mate_3|pr_mate_4|pr_mate_5|pr_mate_6|pr_mate_7|pr_mate_8|pr_mate_9|pr_mate_10|pr_mate_11|pr_mate_12|pr_mate_13|pr_mate_14|pr_mate_15|pr_mate_16|pr_mate_17|pr_mate_18|pr_mate_19|pr_mate_20)$": {
            "type": "integer",
            "minimum": 1,
            "maximum": 5
          }
        }
      }
    },
    "required": [
      "scored_responses"
    ]
  },
  "output_schema": {
    "type": "object",
    "properties": {
      "scores": {
        "type": "object",
        "properties": {
          "total": {
            "type": "object",
            "properties": {
              "value": {
                "type": "number"
              }
            },
            "required": [
              "value"
            ]
          }
        },
        "required": [
          "total"
        ]
      },
      "missing_count": {
        "type": "integer",
        "minimum": 0
      }
    },
    "required": [
      "scores",
      "missing_count"
    ]
  },
  "implementations": [
