        "scored_responses": {
          "pr_trust_1": 1,
          "pr_trust_2": 1,
          "pr_trust_3": 1,
          "pr_trust_4": 1,
          "pr_trust_5": 1,
          "pr_trust_6": 1,
          "pr_trust_7": 1,
          "pr_trust_8": 1,
          "pr_trust_9": 1,
          "pr_trust_10": 1,
