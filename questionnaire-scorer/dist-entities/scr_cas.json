{
  "id": "scr_cas",
  "name": "CAS Total Scoring",
  "content": {
    "en": {
      "status": "validated",
      "name": "CAS Total Scoring",
      "description": "Clinical Anger Scale (CAS). Total = sum of the 21 items (each 0-3, range 0-63); higher = greater clinical anger (reverse-keyed items reversed by the runtime). No standard cut-offs."
    }
  },
  "x_publication": {
    "citation": "Snell, W. E., Jr., Gum, S., Shuck, R. L., Mosley, J. A., & Kite, T. L. (1995). The clinical anger scale: Preliminary reliability and\nvalidity. Journal of Clinical Psychology, 51(2) , 215-226.",
    "year": 1995
  },
  "inputs": {
    "type": "object",
    "properties": {
      "scored_responses": {
        "type": "object",
        "patternProperties": {
          "^(pr_cas_1|pr_cas_2|pr_cas_3|pr_cas_4|pr_cas_5|pr_cas_6|pr_cas_7|pr_cas_8|pr_cas_9|pr_cas_10|pr_cas_11|pr_cas_12|pr_cas_13|pr_cas_14|pr_cas_15|pr_cas_16|pr_cas_17|pr_cas_18|pr_cas_19|pr_cas_20|pr_cas_21)$": {
            "type": "integer",
            "minimum": 0,
            "maximum": 3
          }
        }
      }
    },
    "required": [
      "scored_responses"
    ]
  },
  "output_schema": {
    "type": "object",
    "properties": {
      "scores": {
        "type": "object",
        "properties": {
          "total": {
            "type": "object",
            "properties": {
              "value": {
                "type": "number"
              }
            },
            "required": [
              "value"
            ]
          }
        },
        "required": [
          "total"
        ]
      },
      "missing_count": {
        "type": "integer",
        "minimum": 0
      }
    },
    "required": [
      "scores",
      "missing_count"
    ]
  },
  "implementations": [
    {
      "kind": "wasm",
      "url": "https://behaverse.org/scorers/cas/scorer.wasm",
      "sha256": "0b57f25b8c3698094a48fbbdd2d59ab154d378308b037430ef44bf31e220950d"
    }
  ],
