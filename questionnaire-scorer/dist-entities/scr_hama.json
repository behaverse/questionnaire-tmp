{
  "id": "scr_hama",
  "name": "HAM-A Standard Scoring",
  "content": {
    "en": {
      "status": "validated",
      "name": "HAM-A Standard Scoring",
      "description": "Hamilton Anxiety Rating Scale (Hamilton, 1959). Total = sum of the 14 clinician-rated items (each 0-4), range 0-56. Common severity bands: <18 mild, 18-24 mild-to-moderate, 25-30 moderate-to-severe, 31+ severe anxiety."
    }
  },
  "x_publication": {
    "citation": "Hamilton M (1959). The assessment of anxiety states by rating. Br J Med Psychol, 32(1), 50-55.",
    "year": 1959
  },
  "inputs": {
    "type": "object",
    "properties": {
      "scored_responses": {
        "type": "object",
        "patternProperties": {
          "^(pr_hama_1|pr_hama_2|pr_hama_3|pr_hama_4|pr_hama_5|pr_hama_6|pr_hama_7|pr_hama_8|pr_hama_9|pr_hama_10|pr_hama_11|pr_hama_12|pr_hama_13|pr_hama_14)$": {
            "type": "integer",
            "minimum": 0,
            "maximum": 4
          }
        }
      }
    },
    "required": [
      "scored_responses"
    ]
  },
  "output_schema": {
    "type": "object",
    "properties": {
      "scores": {
        "type": "object",
        "properties": {
          "total": {
            "type": "object",
            "properties": {
              "value": {
                "type": "number"
              },
              "severity": {
                "type": "string",
                "enum": [
                  "mild",
                  "mild_moderate",
                  "moderate_severe",
                  "severe"
                ]
              },
              "band": {
                "type": "object",
                "properties": {
                  "min": {
                    "type": "number"
                  },
                  "max": {
                    "type": "number"
                  },
                  "label": {
                    "type": "string"
                  }
                },
                "required": [
                  "min",
                  "max",
                  "label"
                ]
              }
            },
            "required": [
              "value"
            ]
          }
        },
        "required": [
          "total"
        ]
      },
      "missing_count": {
        "type": "integer",
        "minimum": 0
      }
    },
    "required": [
      "scores",
      "missing_count"
    ]
  },
  "implementations": [
    {
      "kind": "wasm",
      "url": "https://behaverse.org/scorers/hama/scorer.wasm",
      "sha256": "6a8a695174961b20788522d56f7a9903a6b563a353ad2da872d281650d516e16"
    }
  ],
