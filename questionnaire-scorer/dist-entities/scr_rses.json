{
  "id": "scr_rses",
  "name": "RSES Standard Scoring",
  "content": {
    "en": {
      "status": "validated",
      "name": "RSES Standard Scoring",
      "description": "Rosenberg Self-Esteem Scale (Rosenberg, 1965). Total = sum of the 10 items (each 0-3, negatively-worded items reverse-scored by the runtime), range 0-30; higher = higher self-esteem. Common interpretation: 0-14 low self-esteem, 15-25 normal range, 26-30 high self-esteem."
    }
  },
  "x_publication": {
    "citation": "Rosenberg M (1965). Society and the Adolescent Self-Image. Princeton University Press.",
    "year": 1965
  },
  "inputs": {
    "type": "object",
    "properties": {
      "scored_responses": {
        "type": "object",
        "patternProperties": {
          "^(pr_rses_1|pr_rses_2|pr_rses_3|pr_rses_4|pr_rses_5|pr_rses_6|pr_rses_7|pr_rses_8|pr_rses_9|pr_rses_10)$": {
            "type": "integer",
            "minimum": 0,
            "maximum": 3
          }
        }
      }
    },
    "required": [
      "scored_responses"
    ]
  },
  "output_schema": {
    "type": "object",
    "properties": {
      "scores": {
        "type": "object",
        "properties": {
          "total": {
            "type": "object",
            "properties": {
              "value": {
                "type": "number"
              },
              "severity": {
                "type": "string",
                "enum": [
                  "low",
                  "normal",
                  "high"
                ]
              },
              "band": {
                "type": "object",
                "properties": {
                  "min": {
                    "type": "number"
                  },
                  "max": {
                    "type": "number"
                  },
                  "label": {
                    "type": "string"
                  }
                },
                "required": [
                  "min",
                  "max",
                  "label"
                ]
              }
            },
            "required": [
              "value"
            ]
          }
        },
        "required": [
          "total"
        ]
      },
      "missing_count": {
        "type": "integer",
        "minimum": 0
      }
    },
    "required": [
      "scores",
      "missing_count"
    ]
  },
  "implementations": [
    {
      "kind": "wasm",
      "url": "https://behaverse.org/scorers/rses/scorer.wasm",
      "sha256": "0f061fa44d6d251f726b3c06ee94f883cc3906dfc713247d5a9edc893a1b4679"
    }
  ],
  "test_cases": [
    {
      "name": "low-floor",
