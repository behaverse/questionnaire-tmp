        "scored_responses": {
          "pr_rses_1": 0,
          "pr_rses_2": 0,
          "pr_rses_3": 0,
          "pr_rses_4": 0,
          "pr_rses_5": 0,
          "pr_rses_6": 0,
          "pr_rses_7": 0,
          "pr_rses_8": 0,
          "pr_rses_9": 0,
          "pr_rses_10": 0
        }
      },
      "expected": {
        "scores": {
          "total": {
            "value": 0,
            "severity": "low",
            "band": {
              "min": 0,
              "max": 14,
              "label": "Low self-esteem"
            }
          }
        },
        "missing_count": 0
      }
    },
    {
      "name": "normal-mid",
      "input": {
