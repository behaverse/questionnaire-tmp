{
  "id": "scr_erq",
  "name": "ERQ Standard Scoring",
  "content": {
    "en": {
      "status": "validated",
      "name": "ERQ Standard Scoring",
      "description": "Emotion Regulation Questionnaire (Gross & John, 2003). Two subscale MEAN scores (each item 1-7): Cognitive Reappraisal (items 1,3,5,7,8,10) and Expressive Suppression (items 2,4,6,9). Higher = greater habitual use of that strategy; no severity cut-offs."
    }
  },
  "x_publication": {
    "citation": "Gross JJ, John OP (2003). Individual differences in two emotion regulation processes: implications for affect, relationships, and well-being. J Pers Soc Psychol, 85(2), 348-362.",
    "year": 2003
  },
  "inputs": {
    "type": "object",
    "properties": {
      "scored_responses": {
        "type": "object",
        "patternProperties": {
          "^(pr_erq_1|pr_erq_3|pr_erq_5|pr_erq_7|pr_erq_8|pr_erq_10|pr_erq_2|pr_erq_4|pr_erq_6|pr_erq_9)$": {
            "type": "integer",
            "minimum": 1,
            "maximum": 7
          }
        }
      }
    },
    "required": [
      "scored_responses"
    ]
  },
  "output_schema": {
    "type": "object",
    "properties": {
      "scores": {
        "type": "object",
        "properties": {
          "reappraisal": {
            "type": "object",
            "properties": {
              "value": {
                "type": "number"
              }
            },
            "required": [
              "value"
            ]
          },
          "suppression": {
            "type": "object",
            "properties": {
              "value": {
                "type": "number"
              }
            },
            "required": [
              "value"
            ]
          }
        },
        "required": [
          "reappraisal",
          "suppression"
        ]
      },
      "missing_count": {
        "type": "integer",
        "minimum": 0
      }
    },
    "required": [
      "scores",
      "missing_count"
    ]
  },
  "implementations": [
    {
      "kind": "wasm",
      "url": "https://behaverse.org/scorers/erq/scorer.wasm",
      "sha256": "a79b35d8c86e9ab176beffdc6cf0f71788a75ba7c3ee36703f975182d15c157e"
    }
  ],
  "test_cases": [
