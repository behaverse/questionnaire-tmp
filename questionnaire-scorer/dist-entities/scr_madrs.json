{
  "id": "scr_madrs",
  "name": "MADRS Scoring",
  "content": {
    "en": {
      "status": "validated",
      "name": "MADRS Scoring",
      "description": "Montgomery-Asberg Depression Rating Scale (MADRS). Total = sum of the 10 clinician-rated items (each 0-6), range 0-60."
    }
  },
  "inputs": {
    "type": "object",
    "properties": {
      "scored_responses": {
        "type": "object",
        "patternProperties": {
          "^(pr_madrs_1|pr_madrs_2|pr_madrs_3|pr_madrs_4|pr_madrs_5|pr_madrs_6|pr_madrs_7|pr_madrs_8|pr_madrs_9|pr_madrs_10)$": {
            "type": "integer",
            "minimum": 0,
            "maximum": 6
          }
        }
      }
    },
    "required": [
      "scored_responses"
    ]
  },
  "output_schema": {
    "type": "object",
    "properties": {
      "scores": {
        "type": "object",
        "properties": {
          "total": {
            "type": "object",
            "properties": {
              "value": {
                "type": "number"
              },
              "severity": {
                "type": "string",
                "enum": [
                  "normal",
                  "mild",
                  "moderate",
                  "severe"
                ]
              },
              "band": {
                "type": "object",
                "properties": {
                  "min": {
                    "type": "number"
                  },
                  "max": {
                    "type": "number"
                  },
                  "label": {
                    "type": "string"
                  }
                },
                "required": [
                  "min",
                  "max",
                  "label"
                ]
              }
            },
            "required": [
              "value"
            ]
          }
        },
        "required": [
          "total"
        ]
      },
      "missing_count": {
        "type": "integer",
        "minimum": 0
      }
    },
    "required": [
      "scores",
      "missing_count"
    ]
  },
  "implementations": [
    {
      "kind": "wasm",
      "url": "https://behaverse.org/scorers/madrs/scorer.wasm",
      "sha256": "4d43b94bdcbea31b259c5c8e9d4e158a4170c1b2d465dd615388f7110a59afe3"
    }
  ],
  "test_cases": [
    {
      "name": "floor",
      "input": {
        "scored_responses": {
          "pr_madrs_1": 0,
          "pr_madrs_2": 0,
          "pr_madrs_3": 0,
          "pr_madrs_4": 0,
          "pr_madrs_5": 0,
          "pr_madrs_6": 0,
          "pr_madrs_7": 0,
          "pr_madrs_8": 0,
          "pr_madrs_9": 0,
          "pr_madrs_10": 0
        }
      },
      "expected": {
        "scores": {
          "total": {
            "value": 0,
            "severity": "normal",
            "band": {
              "min": 0,
              "max": 6,
              "label": "Symptom absent / normal"
            }
          }
        },
        "missing_count": 0
      }
    },
    {
      "name": "mid",
      "input": {
        "scored_responses": {
          "pr_madrs_1": 3,
          "pr_madrs_2": 3,
          "pr_madrs_3": 3,
          "pr_madrs_4": 3,
          "pr_madrs_5": 3,
          "pr_madrs_6": 3,
          "pr_madrs_7": 3,
          "pr_madrs_8": 3,
          "pr_madrs_9": 3,
          "pr_madrs_10": 3
        }
      },
      "expected": {
        "scores": {
          "total": {
            "value": 30,
            "severity": "moderate",
            "band": {
              "min": 20,
              "max": 34,
              "label": "Moderate depression"
            }
          }
        },
        "missing_count": 0
      }
    },
    {
      "name": "ceiling",
      "input": {
        "scored_responses": {
          "pr_madrs_1": 6,
          "pr_madrs_2": 6,
          "pr_madrs_3": 6,
          "pr_madrs_4": 6,
          "pr_madrs_5": 6,
          "pr_madrs_6": 6,
          "pr_madrs_7": 6,
          "pr_madrs_8": 6,
          "pr_madrs_9": 6,
          "pr_madrs_10": 6
        }
      },
      "expected": {
        "scores": {
          "total": {
            "value": 60,
            "severity": "severe",
            "band": {
              "min": 35,
              "max": 60,
              "label": "Severe depression"
            }
          }
        },
        "missing_count": 0
      }
    }
  ]
}
