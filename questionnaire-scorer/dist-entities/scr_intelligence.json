{
  "id": "scr_intelligence",
  "name": "EI Total Scoring",
  "content": {
    "en": {
      "status": "validated",
      "name": "EI Total Scoring",
      "description": "Emotional Intelligence. Total = sum of the 33 items (each 1-5), range 33-165; higher = greater trait emotional intelligence (reverse-keyed items reversed by the runtime). No standard cut-offs."
    }
  },
  "x_publication": {
    "citation": "Schutte, N. S., Malouff, J. M., Hall, L. E., Haggerty, D. J.,\nCooper, J. T., Golden, C. J., & Dornheim, L. (1998). Development and\nvalidation of a measure of emotional intelligence. Personality and\nIndividual Differences, 25 , 167–177.",
    "year": 1998
  },
  "inputs": {
    "type": "object",
    "properties": {
      "scored_responses": {
        "type": "object",
        "patternProperties": {
          "^(pr_intelligence_1|pr_intelligence_2|pr_intelligence_3|pr_intelligence_4|pr_intelligence_5|pr_intelligence_6|pr_intelligence_7|pr_intelligence_8|pr_intelligence_9|pr_intelligence_10|pr_intelligence_11|pr_intelligence_12|pr_intelligence_13|pr_intelligence_14|pr_intelligence_15|pr_intelligence_16|pr_intelligence_17|pr_intelligence_18|pr_intelligence_19|pr_intelligence_20|pr_intelligence_21|pr_intelligence_22|pr_intelligence_23|pr_intelligence_24|pr_intelligence_25|pr_intelligence_26|pr_intelligence_27|pr_intelligence_28|pr_intelligence_29|pr_intelligence_30|pr_intelligence_31|pr_intelligence_32|pr_intelligence_33)$": {
            "type": "integer",
            "minimum": 1,
            "maximum": 5
          }
        }
      }
    },
    "required": [
      "scored_responses"
    ]
  },
  "output_schema": {
    "type": "object",
    "properties": {
      "scores": {
        "type": "object",
        "properties": {
          "total": {
            "type": "object",
            "properties": {
              "value": {
                "type": "number"
              }
            },
            "required": [
              "value"
            ]
          }
        },
        "required": [
          "total"
        ]
      },
      "missing_count": {
        "type": "integer",
        "minimum": 0
      }
    },
    "required": [
      "scores",
      "missing_count"
    ]
  },
