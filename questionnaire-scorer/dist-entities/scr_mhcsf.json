{
  "id": "scr_mhcsf",
  "name": "MHC-SF Total Scoring",
  "content": {
    "en": {
      "status": "validated",
      "name": "MHC-SF Total Scoring",
      "description": "Mental Health Continuum Short Form (MHC-SF). Total = sum of the 14 items (each 0-5, range 0-70); higher = greater positive mental health (emotional, social and psychological well-being) (reverse-keyed items reversed by the runtime). No standard cut-offs."
    }
  },
  "x_publication": {
    "citation": "Keyes, C.L.M. (2006). Mental health in adolescence: Is America’s youth flourishing? American Journal of Orthopsychiatry, 76 , 395–402.",
    "year": 2006
  },
  "inputs": {
    "type": "object",
    "properties": {
      "scored_responses": {
        "type": "object",
        "patternProperties": {
          "^(pr_mhcsf_1|pr_mhcsf_2|pr_mhcsf_3|pr_mhcsf_4|pr_mhcsf_5|pr_mhcsf_6|pr_mhcsf_7|pr_mhcsf_8|pr_mhcsf_9|pr_mhcsf_10|pr_mhcsf_11|pr_mhcsf_12|pr_mhcsf_13|pr_mhcsf_14)$": {
            "type": "integer",
            "minimum": 0,
            "maximum": 5
          }
        }
      }
    },
    "required": [
      "scored_responses"
    ]
  },
  "output_schema": {
    "type": "object",
    "properties": {
      "scores": {
        "type": "object",
        "properties": {
          "total": {
            "type": "object",
            "properties": {
              "value": {
                "type": "number"
              }
            },
            "required": [
              "value"
            ]
          }
        },
        "required": [
          "total"
        ]
      },
      "missing_count": {
        "type": "integer",
        "minimum": 0
      }
    },
    "required": [
      "scores",
      "missing_count"
    ]
  },
  "implementations": [
    {
      "kind": "wasm",
      "url": "https://behaverse.org/scorers/mhcsf/scorer.wasm",
      "sha256": "64ab3264e8c4a69f04b69b76b561f5f9bc04908ee2ef46978bf486cefe3e162c"
    }
  ],
