{
  "id": "scr_burnout",
  "name": "Teacher Burnout Total Scoring",
  "content": {
    "en": {
      "status": "validated",
      "name": "Teacher Burnout Total Scoring",
      "description": "Teacher burnout. Total = sum of the 20 items (each 1-5), range 20-100. Higher scores indicate greater teacher burnout (reverse-keyed items are reversed by the runtime). No standard severity cut-offs."
    }
  },
  "x_publication": {
    "citation": "Campbell, L.P. (1983). Teacher burnout: Description and\nprescription. The Clearing House, 57 , pp. 111-113",
    "year": 1983
  },
  "inputs": {
    "type": "object",
    "properties": {
      "scored_responses": {
        "type": "object",
        "patternProperties": {
          "^(pr_burnout_1|pr_burnout_2|pr_burnout_3|pr_burnout_4|pr_burnout_5|pr_burnout_6|pr_burnout_7|pr_burnout_8|pr_burnout_9|pr_burnout_10|pr_burnout_11|pr_burnout_12|pr_burnout_13|pr_burnout_14|pr_burnout_15|pr_burnout_16|pr_burnout_17|pr_burnout_18|pr_burnout_19|pr_burnout_20)$": {
            "type": "integer",
            "minimum": 1,
            "maximum": 5
          }
        }
      }
    },
    "required": [
      "scored_responses"
    ]
  },
  "output_schema": {
    "type": "object",
    "properties": {
      "scores": {
        "type": "object",
        "properties": {
          "total": {
            "type": "object",
            "properties": {
              "value": {
                "type": "number"
              }
            },
            "required": [
              "value"
            ]
          }
        },
        "required": [
          "total"
        ]
      },
      "missing_count": {
        "type": "integer",
        "minimum": 0
      }
    },
    "required": [
      "scores",
      "missing_count"
    ]
  },
  "implementations": [
    {
      "kind": "wasm",
      "url": "https://behaverse.org/scorers/burnout/scorer.wasm",
