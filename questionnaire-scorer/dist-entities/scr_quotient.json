{
  "id": "scr_quotient",
  "name": "AQ-10 Scoring",
  "content": {
    "en": {
      "status": "validated",
      "name": "AQ-10 Scoring",
      "description": "Short Autism Spectrum Quotient. Autism-Spectrum Quotient - 10 items (AQ-10; Allison et al., 2012). Total = number of autism-consistent answers (scored 0/1), range 0-10; a score of 6 or more warrants referral for full assessment."
    }
  },
  "x_publication": {
    "citation": "Allison, C., Auyeung, B., & Baron-Cohen, S. (2012). Toward Brief\n\"Red Flags\" for Autism Screening: The Short Autism Spectrum Quotient\nand the Short Quantitative Checklist in 1,000 Cases and 3,000 Controls. Journal of the American Acad of Child & Adolescent Psychiatry, 51(2) , 202-212.",
    "year": 2012
  },
  "inputs": {
    "type": "object",
    "properties": {
      "scored_responses": {
        "type": "object",
        "patternProperties": {
          "^(pr_quotient_1|pr_quotient_2|pr_quotient_3|pr_quotient_4|pr_quotient_5|pr_quotient_6|pr_quotient_7|pr_quotient_8|pr_quotient_9|pr_quotient_10)$": {
            "type": "integer",
            "minimum": 0,
            "maximum": 1
          }
        }
      }
    },
    "required": [
      "scored_responses"
    ]
  },
  "output_schema": {
    "type": "object",
    "properties": {
      "scores": {
        "type": "object",
        "properties": {
          "total": {
            "type": "object",
            "properties": {
              "value": {
                "type": "number"
              },
              "severity": {
                "type": "string",
                "enum": [
                  "below",
                  "refer"
                ]
              },
              "band": {
                "type": "object",
                "properties": {
                  "min": {
                    "type": "number"
                  },
                  "max": {
                    "type": "number"
                  },
                  "label": {
                    "type": "string"
                  }
                },
                "required": [
                  "min",
                  "max",
                  "label"
                ]
              }
            },
            "required": [
              "value"
            ]
          }
        },
        "required": [
          "total"
        ]
      },
      "missing_count": {
        "type": "integer",
        "minimum": 0
      }
    },
    "required": [
      "scores",
      "missing_count"
    ]
  },
  "implementations": [
    {
      "kind": "wasm",
      "url": "https://behaverse.org/scorers/quotient/scorer.wasm",
      "sha256": "94054009e01a7435a5a264ad3b55128e09d923915ae519f45fa1eef31122bf99"
    }
  ],
  "test_cases": [
    {
      "name": "floor",
      "input": {
        "scored_responses": {
          "pr_quotient_1": 0,
          "pr_quotient_2": 0,
          "pr_quotient_3": 0,
          "pr_quotient_4": 0,
          "pr_quotient_5": 0,
          "pr_quotient_6": 0,
          "pr_quotient_7": 0,
          "pr_quotient_8": 0,
          "pr_quotient_9": 0,
          "pr_quotient_10": 0
        }
      },
      "expected": {
        "scores": {
          "total": {
            "value": 0,
            "severity": "below",
            "band": {
              "min": 0,
              "max": 5,
              "label": "Below referral threshold"
            }
          }
        },
        "missing_count": 0
      }
    },
    {
      "name": "ceiling",
      "input": {
        "scored_responses": {
          "pr_quotient_1": 1,
          "pr_quotient_2": 1,
          "pr_quotient_3": 1,
          "pr_quotient_4": 1,
          "pr_quotient_5": 1,
          "pr_quotient_6": 1,
          "pr_quotient_7": 1,
          "pr_quotient_8": 1,
          "pr_quotient_9": 1,
          "pr_quotient_10": 1
        }
      },
      "expected": {
        "scores": {
          "total": {
            "value": 10,
            "severity": "refer",
            "band": {
              "min": 6,
              "max": 10,
              "label": "Consider referral for assessment"
            }
          }
        },
        "missing_count": 0
      }
    }
  ]
}
