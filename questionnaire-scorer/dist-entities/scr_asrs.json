{
  "id": "scr_asrs",
  "name": "ASRS Part-A Screener",
  "content": {
    "en": {
      "status": "validated",
      "name": "ASRS Part-A Screener",
      "description": "Adult ADHD Self-Report Scale v1.1 Part A (Kessler et al., 2005). Counts the 6 screener items in the grey zone (items 1-3 answered 'Sometimes' or more; items 4-6 'Often' or more), range 0-6; 4 or more is highly consistent with ADHD."
    }
  },
  "x_publication": {
    "citation": "Kessler RC, Adler L, Ames M, et al. (2005). The World Health Organization Adult ADHD Self-Report Scale (ASRS). Psychol Med, 35(2), 245-256.",
    "year": 2005
  },
  "inputs": {
    "type": "object",
    "properties": {
      "scored_responses": {
        "type": "object",
        "patternProperties": {
          "^pr_asrs_[1-6]$": {
            "type": "integer",
            "minimum": 1,
            "maximum": 5
          }
        }
      }
    },
    "required": [
      "scored_responses"
    ]
  },
  "output_schema": {
    "type": "object",
    "properties": {
      "part_a": {
        "type": "integer",
        "minimum": 0,
        "maximum": 6
      },
      "severity": {
        "type": "string",
        "enum": [
          "negative",
          "positive"
        ]
      },
      "band": {
        "type": "object",
        "properties": {
          "min": {
            "type": "integer"
          },
          "max": {
            "type": "integer"
          },
          "label": {
            "type": "string"
          }
        },
        "required": [
          "min",
          "max",
          "label"
        ]
      },
      "missing_count": {
        "type": "integer",
        "minimum": 0,
        "maximum": 6
      }
    },
    "required": [
      "part_a",
      "severity",
      "band",
      "missing_count"
    ]
  },
  "implementations": [
    {
      "kind": "wasm",
      "url": "https://behaverse.org/scorers/asrs/scorer.wasm",
      "sha256": "84e6a72499f5e96609bf875d853ea0193e2b9dcfd748d71220f3ca119cc79719"
    }
  ],
  "test_cases": [
    {
      "name": "positive",
      "input": {
        "scored_responses": {
          "pr_asrs_1": 3,
          "pr_asrs_2": 3,
          "pr_asrs_3": 3,
          "pr_asrs_4": 4,
          "pr_asrs_5": 4,
          "pr_asrs_6": 4
        }
      },
      "expected": {
        "part_a": 6,
        "severity": "positive",
        "band": {
          "min": 4,
          "max": 6,
          "label": "Symptoms highly consistent with ADHD \u2014 further investigation warranted"
        },
        "missing_count": 0
      }
    },
    {
      "name": "negative",
      "input": {
        "scored_responses": {
          "pr_asrs_1": 3,
          "pr_asrs_2": 3,
          "pr_asrs_3": 3,
          "pr_asrs_4": 3,
          "pr_asrs_5": 3,
          "pr_asrs_6": 3
        }
      },
      "expected": {
        "part_a": 3,
        "severity": "negative",
        "band": {
          "min": 0,
          "max": 3,
          "label": "Symptoms not consistent with ADHD"
        },
        "missing_count": 0
      }
    }
  ]
}
