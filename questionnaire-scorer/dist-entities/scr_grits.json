{
  "id": "scr_grits",
  "name": "Grit-S Total Scoring",
  "content": {
    "en": {
      "status": "validated",
      "name": "Grit-S Total Scoring",
      "description": "Short Grit Scale (Grit-S). Score = MEAN of the 8 items (each 1-5), range 1-5. Higher scores indicate greater grit (perseverance and consistency of interest) (reverse-keyed items are reversed by the runtime). No standard severity cut-offs."
    }
  },
  "x_publication": {
    "citation": "Duckworth, A.L., Peterson, C., Matthews, M.D., & Kelly, D.R. (2007). Grit: Perseverance and\npassion for long-term goals. Journal of Personality and Social Psychology, 9 , 1087-1101. Free download via Research Gate",
    "year": 2007
  },
  "inputs": {
    "type": "object",
    "properties": {
      "scored_responses": {
        "type": "object",
        "patternProperties": {
          "^(pr_grits_1|pr_grits_2|pr_grits_3|pr_grits_4|pr_grits_5|pr_grits_6|pr_grits_7|pr_grits_8)$": {
            "type": "integer",
            "minimum": 1,
            "maximum": 5
          }
        }
      }
    },
    "required": [
      "scored_responses"
    ]
  },
  "output_schema": {
    "type": "object",
    "properties": {
      "scores": {
        "type": "object",
        "properties": {
          "total": {
            "type": "object",
            "properties": {
              "value": {
                "type": "number"
              }
            },
            "required": [
              "value"
            ]
          }
        },
        "required": [
          "total"
        ]
      },
      "missing_count": {
        "type": "integer",
        "minimum": 0
      }
    },
    "required": [
      "scores",
      "missing_count"
    ]
  },
  "implementations": [
    {
      "kind": "wasm",
      "url": "https://behaverse.org/scorers/grits/scorer.wasm",
      "sha256": "b24f5ee564e9c94a5435ad0cc47e45502577c249546923d92a3afd4d8749eec8"
    }
  ],
  "test_cases": [
    {
      "name": "floor",
      "input": {
        "scored_responses": {
          "pr_grits_1": 1,
          "pr_grits_2": 1,
          "pr_grits_3": 1,
          "pr_grits_4": 1,
          "pr_grits_5": 1,
          "pr_grits_6": 1,
          "pr_grits_7": 1,
          "pr_grits_8": 1
        }
      },
      "expected": {
        "scores": {
          "total": {
            "value": 1
          }
        },
        "missing_count": 0
      }
    },
    {
      "name": "mid",
      "input": {
        "scored_responses": {
          "pr_grits_1": 3,
          "pr_grits_2": 3,
          "pr_grits_3": 3,
          "pr_grits_4": 3,
          "pr_grits_5": 3,
          "pr_grits_6": 3,
          "pr_grits_7": 3,
          "pr_grits_8": 3
        }
      },
      "expected": {
        "scores": {
          "total": {
            "value": 3
          }
        },
        "missing_count": 0
      }
    },
    {
      "name": "ceiling",
      "input": {
        "scored_responses": {
          "pr_grits_1": 5,
          "pr_grits_2": 5,
          "pr_grits_3": 5,
          "pr_grits_4": 5,
          "pr_grits_5": 5,
          "pr_grits_6": 5,
          "pr_grits_7": 5,
          "pr_grits_8": 5
        }
      },
      "expected": {
        "scores": {
          "total": {
            "value": 5
          }
        },
        "missing_count": 0
      }
    }
  ]
}
