{
  "id": "scr_eat26",
  "name": "EAT-26 Scoring",
  "content": {
    "en": {
      "status": "validated",
      "name": "EAT-26 Scoring",
      "description": "Eating Attitudes Test - 26 Item (EAT-26). Eating Attitudes Test-26 (Garner et al., 1982). Total = sum of the 26 attitude items (each scored 0-3; the 6 behavioural items are not part of this score), range 0-78; a total of 20 or more is a positive screen."
    }
  },
  "inputs": {
    "type": "object",
    "properties": {
      "scored_responses": {
        "type": "object",
        "patternProperties": {
          "^(pr_eat26_1|pr_eat26_2|pr_eat26_3|pr_eat26_4|pr_eat26_5|pr_eat26_6|pr_eat26_7|pr_eat26_8|pr_eat26_9|pr_eat26_10|pr_eat26_11|pr_eat26_12|pr_eat26_13|pr_eat26_14|pr_eat26_15|pr_eat26_16|pr_eat26_17|pr_eat26_18|pr_eat26_19|pr_eat26_20|pr_eat26_21|pr_eat26_22|pr_eat26_23|pr_eat26_24|pr_eat26_25|pr_eat26_26)$": {
            "type": "integer",
            "minimum": 0,
            "maximum": 3
          }
        }
      }
    },
    "required": [
      "scored_responses"
    ]
  },
  "output_schema": {
    "type": "object",
    "properties": {
      "scores": {
        "type": "object",
        "properties": {
          "total": {
            "type": "object",
            "properties": {
              "value": {
                "type": "number"
              },
              "severity": {
                "type": "string",
                "enum": [
                  "below",
                  "at_or_above"
                ]
              },
              "band": {
                "type": "object",
                "properties": {
                  "min": {
                    "type": "number"
                  },
                  "max": {
                    "type": "number"
                  },
                  "label": {
                    "type": "string"
                  }
                },
                "required": [
                  "min",
                  "max",
                  "label"
                ]
              }
            },
            "required": [
              "value"
            ]
          }
        },
        "required": [
          "total"
        ]
      },
      "missing_count": {
        "type": "integer",
        "minimum": 0
      }
    },
    "required": [
      "scores",
      "missing_count"
    ]
  },
  "implementations": [
    {
      "kind": "wasm",
      "url": "https://behaverse.org/scorers/eat26/scorer.wasm",
      "sha256": "e829e380f8f422311a9f7bea86e4b1d267b27b956197a4fde2367f28aa5352d3"
