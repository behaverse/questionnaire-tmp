{
  "id": "scr_piu",
  "name": "PIU Total Scoring",
  "content": {
    "en": {
      "status": "validated",
      "name": "PIU Total Scoring",
      "description": "Pathological Internet Use (PIU). Total = sum of the 13 items (each 0-1, range 0-13); higher = greater pathological internet use (reverse-keyed items reversed by the runtime). No standard cut-offs."
    }
  },
  "x_publication": {
    "citation": "Morahan-Martin, J. and Schumacher, P. (2000). Incidence and\ncorrelates of pathological Internet use among college\nstudents. Computers in Human Behavior, 16 , 13-29.",
    "year": 2000
  },
  "inputs": {
    "type": "object",
    "properties": {
      "scored_responses": {
        "type": "object",
        "patternProperties": {
          "^(pr_piu_1|pr_piu_2|pr_piu_3|pr_piu_4|pr_piu_5|pr_piu_6|pr_piu_7|pr_piu_8|pr_piu_9|pr_piu_10|pr_piu_11|pr_piu_12|pr_piu_13)$": {
            "type": "integer",
            "minimum": 0,
            "maximum": 1
          }
        }
      }
    },
    "required": [
      "scored_responses"
    ]
  },
  "output_schema": {
    "type": "object",
    "properties": {
      "scores": {
        "type": "object",
        "properties": {
          "total": {
            "type": "object",
            "properties": {
              "value": {
                "type": "number"
              }
            },
            "required": [
              "value"
            ]
          }
        },
        "required": [
          "total"
        ]
      },
      "missing_count": {
        "type": "integer",
        "minimum": 0
      }
    },
    "required": [
      "scores",
      "missing_count"
    ]
  },
  "implementations": [
    {
      "kind": "wasm",
      "url": "https://behaverse.org/scorers/piu/scorer.wasm",
      "sha256": "7d38dea705ab1532276c02471cd1e5e408286189b5baac6675715006093defb2"
    }
  ],
  "test_cases": [
    {
      "name": "floor",
      "input": {
        "scored_responses": {
          "pr_piu_1": 0,
          "pr_piu_2": 0,
          "pr_piu_3": 0,
          "pr_piu_4": 0,
          "pr_piu_5": 0,
          "pr_piu_6": 0,
          "pr_piu_7": 0,
          "pr_piu_8": 0,
          "pr_piu_9": 0,
          "pr_piu_10": 0,
          "pr_piu_11": 0,
          "pr_piu_12": 0,
          "pr_piu_13": 0
        }
      },
      "expected": {
        "scores": {
          "total": {
            "value": 0
          }
        },
        "missing_count": 0
      }
    },
    {
