{
  "id": "scr_lotr",
  "name": "LOT-R Scoring",
  "content": {
    "en": {
      "status": "validated",
      "name": "LOT-R Scoring",
      "description": "Optimism (LOT-R). Life Orientation Test-Revised (Scheier et al., 1994). Optimism = sum of the 6 scored items (1,3,4,7,9,10; items 4 fillers 2,5,6,8 excluded; reverse handled), range 0-24; higher = more dispositional optimism."
    }
  },
  "x_publication": {
    "citation": "Scheier, M. F., & Carver, C. S. (1992). Effects of optimism on psychological and physical well-being:\nTheoretical overview and empirical update. Cognitive Therapy and Research, 16 , 201-228.",
    "year": 1992
  },
  "inputs": {
    "type": "object",
    "properties": {
      "scored_responses": {
        "type": "object",
        "patternProperties": {
          "^(pr_lotr_1|pr_lotr_3|pr_lotr_4|pr_lotr_7|pr_lotr_9|pr_lotr_10)$": {
            "type": "integer",
            "minimum": 0,
            "maximum": 4
          }
        }
      }
    },
    "required": [
      "scored_responses"
    ]
  },
  "output_schema": {
    "type": "object",
    "properties": {
      "scores": {
        "type": "object",
        "properties": {
          "optimism": {
            "type": "object",
            "properties": {
              "value": {
                "type": "number"
              }
            },
            "required": [
              "value"
            ]
          }
        },
        "required": [
          "optimism"
        ]
      },
      "missing_count": {
        "type": "integer",
        "minimum": 0
      }
    },
    "required": [
      "scores",
      "missing_count"
    ]
  },
  "implementations": [
    {
      "kind": "wasm",
      "url": "https://behaverse.org/scorers/lotr/scorer.wasm",
      "sha256": "05fe5b342ad255bbc2de87483f05a9bd1b4c9ccffea12b8c31ac8dcd3952e830"
    }
  ],
  "test_cases": [
    {
      "name": "floor",
      "input": {
        "scored_responses": {
          "pr_lotr_1": 0,
          "pr_lotr_3": 0,
          "pr_lotr_4": 0,
          "pr_lotr_7": 0,
          "pr_lotr_9": 0,
          "pr_lotr_10": 0
        }
      },
      "expected": {
        "scores": {
          "optimism": {
            "value": 0
          }
        },
        "missing_count": 0
      }
    },
    {
      "name": "mid",
      "input": {
        "scored_responses": {
          "pr_lotr_1": 2,
          "pr_lotr_3": 2,
          "pr_lotr_4": 2,
          "pr_lotr_7": 2,
          "pr_lotr_9": 2,
          "pr_lotr_10": 2
        }
      },
      "expected": {
        "scores": {
          "optimism": {
            "value": 12
          }
        },
        "missing_count": 0
      }
    },
    {
      "name": "ceiling",
      "input": {
        "scored_responses": {
          "pr_lotr_1": 4,
          "pr_lotr_3": 4,
          "pr_lotr_4": 4,
          "pr_lotr_7": 4,
          "pr_lotr_9": 4,
          "pr_lotr_10": 4
        }
      },
      "expected": {
        "scores": {
          "optimism": {
            "value": 24
          }
        },
        "missing_count": 0
      }
    }
  ]
}
