{
  "id": "scr_brcs",
  "name": "BRCS Total Scoring",
  "content": {
    "en": {
      "status": "validated",
      "name": "BRCS Total Scoring",
      "description": "Resilience (BRCS). Total = sum of the 4 items (each 1-5, range 4-20); higher = greater adaptive (resilient) coping (reverse-keyed items reversed by the runtime). No standard cut-offs."
    }
  },
  "x_publication": {
    "citation": "Sinclair, V. G., & Wallston, K.A. (2004). The development and psychometric evaluation of the\nBrief Resilient Coping Scale. Assessment, 11 (1) , 94-101.",
    "year": 2004
  },
  "inputs": {
    "type": "object",
    "properties": {
      "scored_responses": {
        "type": "object",
        "patternProperties": {
          "^(pr_brcs_1|pr_brcs_2|pr_brcs_3|pr_brcs_4)$": {
            "type": "integer",
            "minimum": 1,
            "maximum": 5
          }
        }
      }
    },
    "required": [
      "scored_responses"
    ]
  },
  "output_schema": {
    "type": "object",
    "properties": {
      "scores": {
        "type": "object",
        "properties": {
          "total": {
            "type": "object",
            "properties": {
              "value": {
                "type": "number"
              }
            },
            "required": [
              "value"
            ]
          }
        },
        "required": [
          "total"
        ]
      },
      "missing_count": {
        "type": "integer",
        "minimum": 0
      }
    },
    "required": [
      "scores",
      "missing_count"
    ]
  },
  "implementations": [
    {
      "kind": "wasm",
      "url": "https://behaverse.org/scorers/brcs/scorer.wasm",
      "sha256": "1c16ccd09c376fa56eb31a5d864bdc2aaa36cfe7b358bcecb78ec3a0ff231616"
    }
  ],
  "test_cases": [
    {
      "name": "floor",
      "input": {
        "scored_responses": {
          "pr_brcs_1": 1,
          "pr_brcs_2": 1,
          "pr_brcs_3": 1,
          "pr_brcs_4": 1
        }
      },
      "expected": {
        "scores": {
          "total": {
            "value": 4
          }
        },
        "missing_count": 0
      }
    },
    {
      "name": "mid",
      "input": {
        "scored_responses": {
          "pr_brcs_1": 3,
          "pr_brcs_2": 3,
          "pr_brcs_3": 3,
          "pr_brcs_4": 3
        }
      },
      "expected": {
        "scores": {
          "total": {
            "value": 12
          }
        },
        "missing_count": 0
      }
    },
    {
      "name": "ceiling",
      "input": {
        "scored_responses": {
          "pr_brcs_1": 5,
          "pr_brcs_2": 5,
          "pr_brcs_3": 5,
          "pr_brcs_4": 5
        }
      },
      "expected": {
        "scores": {
          "total": {
            "value": 20
          }
        },
        "missing_count": 0
      }
    }
  ]
}
