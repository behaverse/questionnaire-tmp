{
  "id": "scr_raads14",
  "name": "RAADS-14 Total Scoring",
  "content": {
    "en": {
      "status": "validated",
      "name": "RAADS-14 Total Scoring",
      "description": "Ritvo Autism & Asperger Diagnostic Scale (RAADS-14). Total = sum of the 14 items (each 0-3, range 0-42); higher = greater autistic traits (reverse-keyed items reversed by the runtime). No standard cut-offs."
    }
  },
  "x_publication": {
    "citation": "J M Eriksson, L M Andersen, & S Bejerot. RAADS-14 Screen: validity of a screening tool for autism spectrum disorder in an adult psychiatric population. Molecular Autism, ( 4 ): 49. Dec 2013",
    "year": 2013
  },
  "inputs": {
    "type": "object",
    "properties": {
      "scored_responses": {
        "type": "object",
        "patternProperties": {
          "^(pr_raads14_1|pr_raads14_2|pr_raads14_3|pr_raads14_4|pr_raads14_5|pr_raads14_6|pr_raads14_7|pr_raads14_8|pr_raads14_9|pr_raads14_10|pr_raads14_11|pr_raads14_12|pr_raads14_13|pr_raads14_14)$": {
            "type": "integer",
            "minimum": 0,
            "maximum": 3
          }
        }
      }
    },
    "required": [
      "scored_responses"
    ]
  },
  "output_schema": {
    "type": "object",
    "properties": {
      "scores": {
        "type": "object",
        "properties": {
          "total": {
            "type": "object",
            "properties": {
              "value": {
                "type": "number"
              }
            },
            "required": [
              "value"
            ]
          }
        },
        "required": [
          "total"
        ]
      },
      "missing_count": {
        "type": "integer",
        "minimum": 0
      }
    },
    "required": [
      "scores",
      "missing_count"
    ]
  },
