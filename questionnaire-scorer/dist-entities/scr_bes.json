{
  "id": "scr_bes",
  "name": "BES Total Scoring",
  "content": {
    "en": {
      "status": "validated",
      "name": "BES Total Scoring",
      "description": "Body Esteem Scale (BES). Total = sum of the 35 items (each 1-5), range 35-175; higher = greater body esteem (reverse-keyed items reversed by the runtime). No standard cut-offs."
    }
  },
  "x_publication": {
    "citation": "Franzoi, S.L. (1994). Further evidence of the reliability and validity of the body esteem scale. Journal of Clinical Psychology, 50 , 237-239.",
    "year": 1994
  },
  "inputs": {
    "type": "object",
    "properties": {
      "scored_responses": {
        "type": "object",
        "patternProperties": {
          "^(pr_bes_1|pr_bes_2|pr_bes_3|pr_bes_4|pr_bes_5|pr_bes_6|pr_bes_7|pr_bes_8|pr_bes_9|pr_bes_10|pr_bes_11|pr_bes_12|pr_bes_13|pr_bes_14|pr_bes_15|pr_bes_16|pr_bes_17|pr_bes_18|pr_bes_19|pr_bes_20|pr_bes_21|pr_bes_22|pr_bes_23|pr_bes_24|pr_bes_25|pr_bes_26|pr_bes_27|pr_bes_28|pr_bes_29|pr_bes_30|pr_bes_31|pr_bes_32|pr_bes_33|pr_bes_34|pr_bes_35)$": {
            "type": "integer",
            "minimum": 1,
            "maximum": 5
          }
        }
      }
    },
    "required": [
      "scored_responses"
    ]
  },
  "output_schema": {
    "type": "object",
    "properties": {
      "scores": {
        "type": "object",
        "properties": {
          "total": {
            "type": "object",
            "properties": {
              "value": {
                "type": "number"
              }
            },
            "required": [
              "value"
            ]
          }
        },
        "required": [
          "total"
        ]
      },
      "missing_count": {
        "type": "integer",
        "minimum": 0
      }
    },
    "required": [
      "scores",
      "missing_count"
    ]
  },
  "implementations": [
