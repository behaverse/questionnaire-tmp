{
  "id": "scr_cage",
  "name": "CAGE Standard Scoring",
  "content": {
    "en": {
      "status": "validated",
      "name": "CAGE Standard Scoring",
      "description": "CAGE alcohol screening questionnaire (Ewing, 1984). Total = number of 'yes' answers across the 4 items (range 0-4); a total of 2 or more is a positive screen suggesting the need for further assessment of alcohol problems."
    }
  },
  "x_publication": {
    "citation": "Ewing JA (1984). Detecting alcoholism: the CAGE questionnaire. JAMA, 252(14), 1905-1907.",
    "year": 1984
  },
  "inputs": {
    "type": "object",
    "properties": {
      "scored_responses": {
        "type": "object",
        "patternProperties": {
          "^(pr_cage_1|pr_cage_2|pr_cage_3|pr_cage_4)$": {
            "type": "integer",
            "minimum": 0,
            "maximum": 1
          }
        }
      }
    },
    "required": [
      "scored_responses"
    ]
  },
  "output_schema": {
    "type": "object",
    "properties": {
      "scores": {
        "type": "object",
        "properties": {
          "total": {
            "type": "object",
            "properties": {
              "value": {
                "type": "number"
              },
              "severity": {
                "type": "string",
                "enum": [
                  "negative",
                  "positive"
                ]
              },
              "band": {
                "type": "object",
                "properties": {
                  "min": {
                    "type": "number"
                  },
                  "max": {
                    "type": "number"
                  },
                  "label": {
                    "type": "string"
                  }
                },
                "required": [
                  "min",
                  "max",
                  "label"
                ]
              }
            },
            "required": [
              "value"
            ]
          }
        },
        "required": [
          "total"
        ]
      },
      "missing_count": {
        "type": "integer",
        "minimum": 0
      }
    },
    "required": [
      "scores",
      "missing_count"
    ]
  },
  "implementations": [
    {
      "kind": "wasm",
      "url": "https://behaverse.org/scorers/cage/scorer.wasm",
      "sha256": "87568f836b9bbc40e59c9152ad649310d59846ff2531f863a8c4b3d3cd5528b4"
    }
  ],
  "test_cases": [
    {
      "name": "negative",
      "input": {
        "scored_responses": {
          "pr_cage_1": 0,
          "pr_cage_2": 0,
          "pr_cage_3": 0,
          "pr_cage_4": 0
        }
      },
      "expected": {
        "scores": {
          "total": {
            "value": 0,
            "severity": "negative",
            "band": {
              "min": 0,
              "max": 1,
              "label": "Negative screen"
            }
          }
        },
        "missing_count": 0
      }
    },
    {
      "name": "positive",
      "input": {
        "scored_responses": {
          "pr_cage_1": 1,
          "pr_cage_2": 1,
          "pr_cage_3": 1,
          "pr_cage_4": 1
        }
      },
      "expected": {
        "scores": {
          "total": {
            "value": 4,
            "severity": "positive",
            "band": {
              "min": 2,
              "max": 4,
              "label": "Positive screen — assess for alcohol problem"
            }
          }
        },
        "missing_count": 0
      }
    }
  ]
}
