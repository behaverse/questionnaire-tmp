{
  "id": "scr_scsr",
  "name": "SCS-R Total Scoring",
  "content": {
    "en": {
      "status": "validated",
      "name": "SCS-R Total Scoring",
      "description": "Self-consciousness scale (revised version). Total = sum of the 21 items (each 0-3), range 0-63; higher = greater dispositional self-consciousness (reverse-keyed items reversed by the runtime). No standard cut-offs."
    }
  },
  "x_publication": {
    "citation": "Scheier, M. F. & Carver, C. S. (1985). The self-consciousnes scale -\na revised version for use with general populations. Journal of\nApplied Social Psychology, 15, 687-699.",
    "year": 1985
  },
  "inputs": {
    "type": "object",
    "properties": {
      "scored_responses": {
        "type": "object",
        "patternProperties": {
          "^(pr_scsr_1|pr_scsr_2|pr_scsr_3|pr_scsr_4|pr_scsr_5|pr_scsr_6|pr_scsr_7|pr_scsr_8|pr_scsr_9|pr_scsr_10|pr_scsr_11|pr_scsr_12|pr_scsr_13|pr_scsr_14|pr_scsr_15|pr_scsr_16|pr_scsr_17|pr_scsr_18|pr_scsr_19|pr_scsr_20|pr_scsr_21)$": {
            "type": "integer",
            "minimum": 0,
            "maximum": 3
          }
        }
      }
    },
    "required": [
      "scored_responses"
    ]
  },
  "output_schema": {
    "type": "object",
    "properties": {
      "scores": {
        "type": "object",
        "properties": {
          "total": {
            "type": "object",
            "properties": {
              "value": {
                "type": "number"
              }
            },
            "required": [
              "value"
            ]
          }
        },
        "required": [
          "total"
        ]
      },
      "missing_count": {
        "type": "integer",
        "minimum": 0
      }
    },
    "required": [
      "scores",
      "missing_count"
    ]
  },
  "implementations": [
