{
  "id": "scr_bsri",
  "name": "BSRI Scoring",
  "content": {
    "en": {
      "status": "validated",
      "name": "BSRI Scoring",
      "description": "Bem sex role inventory (BSRI). Two MEAN scores (each 1-7): Femininity = mean of the 20 feminine items (1-20), Masculinity = mean of the 20 masculine items (21-40). The 20 neutral filler items (41-60) are not scored."
    }
  },
  "x_publication": {
    "citation": "Bem, S. L. (1974) The measurement of psychological\nandrogyny. Journal of Consulting and Clinical Psychology, 42 ,\n155-162.",
    "year": 1974
  },
  "inputs": {
    "type": "object",
    "properties": {
      "scored_responses": {
        "type": "object",
        "patternProperties": {
          "^(pr_bsri_1|pr_bsri_2|pr_bsri_3|pr_bsri_4|pr_bsri_5|pr_bsri_6|pr_bsri_7|pr_bsri_8|pr_bsri_9|pr_bsri_10|pr_bsri_11|pr_bsri_12|pr_bsri_13|pr_bsri_14|pr_bsri_15|pr_bsri_16|pr_bsri_17|pr_bsri_18|pr_bsri_19|pr_bsri_20|pr_bsri_21|pr_bsri_22|pr_bsri_23|pr_bsri_24|pr_bsri_25|pr_bsri_26|pr_bsri_27|pr_bsri_28|pr_bsri_29|pr_bsri_30|pr_bsri_31|pr_bsri_32|pr_bsri_33|pr_bsri_34|pr_bsri_35|pr_bsri_36|pr_bsri_37|pr_bsri_38|pr_bsri_39|pr_bsri_40)$": {
            "type": "integer",
            "minimum": 1,
            "maximum": 7
          }
        }
      }
    },
    "required": [
