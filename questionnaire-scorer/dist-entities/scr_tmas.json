  "content": {
    "en": {
      "status": "validated",
      "name": "TMAS Scoring",
      "description": "Taylor Manifest Anxiety Scale. Total = sum of the 38 true/false items (reverse-keyed items handled), range 0-38; higher = more manifest anxiety. No standard cut-offs."
    }
  },
  "x_publication": {
    "citation": "Janet A. Taylor. A Personality Scale of Manifest Anxiety. 48 ( 2 ) J. Abnormal and Social Psych. 285-290. 1953.",
    "year": 1953
  },
