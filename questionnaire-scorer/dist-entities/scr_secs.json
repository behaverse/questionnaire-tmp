          "pr_secs_3": 100,
          "pr_secs_4": 100,
          "pr_secs_5": 100,
          "pr_secs_6": 100,
          "pr_secs_7": 100,
          "pr_secs_8": 100,
          "pr_secs_9": 100,
          "pr_secs_10": 100,
          "pr_secs_11": 100,
          "pr_secs_12": 100
        }
      },
      "expected": {
