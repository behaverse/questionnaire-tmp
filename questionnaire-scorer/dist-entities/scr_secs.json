{
  "id": "scr_secs",
  "name": "SECS Scoring",
  "content": {
    "en": {
      "status": "validated",
      "name": "SECS Scoring",
      "description": "Political conservatism scale (SECS). Mean of the 12 items (each 0-100; reverse-keyed items reversed by the runtime); higher = greater political conservatism (0-100 thermometer ratings). No standard cut-offs."
    }
  },
  "x_publication": {
    "citation": "Everett, J.E. (2013). The 12 Item Social and Economic Conservatism\nScale\n(SECS). Open\naccess link here",
    "year": 2013
  },
  "inputs": {
    "type": "object",
    "properties": {
      "scored_responses": {
        "type": "object",
        "patternProperties": {
          "^(pr_secs_1|pr_secs_2|pr_secs_3|pr_secs_4|pr_secs_5|pr_secs_6|pr_secs_7|pr_secs_8|pr_secs_9|pr_secs_10|pr_secs_11|pr_secs_12)$": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100
          }
        }
      }
    },
    "required": [
      "scored_responses"
    ]
  },
  "output_schema": {
    "type": "object",
    "properties": {
      "scores": {
        "type": "object",
        "properties": {
          "total": {
            "type": "object",
            "properties": {
              "value": {
                "type": "number"
              }
            },
            "required": [
              "value"
            ]
          }
        },
        "required": [
          "total"
        ]
      },
      "missing_count": {
        "type": "integer",
        "minimum": 0
      }
    },
    "required": [
      "scores",
      "missing_count"
    ]
  },
  "implementations": [
    {
      "kind": "wasm",
      "url": "https://behaverse.org/scorers/secs/scorer.wasm",
      "sha256": "5a12b34bf63ff7208f3f1200117ca90bcb08a0214749333fe35b331b4402ddf7"
    }
  ],
  "test_cases": [
    {
      "name": "floor",
      "input": {
        "scored_responses": {
          "pr_secs_1": 0,
          "pr_secs_2": 0,
          "pr_secs_3": 0,
          "pr_secs_4": 0,
          "pr_secs_5": 0,
          "pr_secs_6": 0,
          "pr_secs_7": 0,
          "pr_secs_8": 0,
          "pr_secs_9": 0,
          "pr_secs_10": 0,
          "pr_secs_11": 0,
          "pr_secs_12": 0
        }
      },
      "expected": {
        "scores": {
          "total": {
            "value": 0
          }
        },
        "missing_count": 0
      }
    },
    {
      "name": "mid",
      "input": {
        "scored_responses": {
          "pr_secs_1": 50,
          "pr_secs_2": 50,
          "pr_secs_3": 50,
          "pr_secs_4": 50,
          "pr_secs_5": 50,
          "pr_secs_6": 50,
          "pr_secs_7": 50,
          "pr_secs_8": 50,
          "pr_secs_9": 50,
          "pr_secs_10": 50,
          "pr_secs_11": 50,
          "pr_secs_12": 50
        }
      },
      "expected": {
        "scores": {
          "total": {
            "value": 50
          }
        },
        "missing_count": 0
      }
    },
    {
      "name": "ceiling",
      "input": {
        "scored_responses": {
          "pr_secs_1": 100,
