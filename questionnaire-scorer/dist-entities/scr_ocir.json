{
  "id": "scr_ocir",
  "name": "OCI-R Standard Scoring",
  "content": {
    "en": {
      "status": "validated",
      "name": "OCI-R Standard Scoring",
      "description": "Obsessive-Compulsive Inventory-Revised (Foa et al., 2002). Total = sum of the 18 items (each 0-4), range 0-72. A total of 21 or more is the recommended clinical cut-off indicating probable obsessive-compulsive disorder."
    }
  },
  "x_publication": {
    "citation": "Foa EB, Huppert JD, Leiberg S, Langner R, Kichic R, Hajcak G, Salkovskis PM (2002). The Obsessive-Compulsive Inventory: development and validation of a short version. Psychol Assess, 14(4), 485-496.",
    "year": 2002
  },
  "inputs": {
    "type": "object",
    "properties": {
      "scored_responses": {
        "type": "object",
        "patternProperties": {
          "^(pr_ocir_1|pr_ocir_2|pr_ocir_3|pr_ocir_4|pr_ocir_5|pr_ocir_6|pr_ocir_7|pr_ocir_8|pr_ocir_9|pr_ocir_10|pr_ocir_11|pr_ocir_12|pr_ocir_13|pr_ocir_14|pr_ocir_15|pr_ocir_16|pr_ocir_17|pr_ocir_18)$": {
            "type": "integer",
            "minimum": 0,
            "maximum": 4
          }
        }
      }
    },
    "required": [
      "scored_responses"
    ]
  },
  "output_schema": {
    "type": "object",
    "properties": {
      "scores": {
        "type": "object",
        "properties": {
          "total": {
            "type": "object",
            "properties": {
              "value": {
                "type": "number"
              },
              "severity": {
                "type": "string",
                "enum": [
                  "below_cutoff",
                  "at_or_above_cutoff"
                ]
              },
              "band": {
                "type": "object",
                "properties": {
                  "min": {
                    "type": "number"
                  },
                  "max": {
                    "type": "number"
                  },
                  "label": {
                    "type": "string"
                  }
                },
                "required": [
                  "min",
                  "max",
                  "label"
                ]
              }
            },
            "required": [
              "value"
            ]
          }
        },
        "required": [
          "total"
        ]
      },
      "missing_count": {
        "type": "integer",
        "minimum": 0
      }
    },
    "required": [
      "scores",
      "missing_count"
    ]
  },
  "implementations": [
    {
      "kind": "wasm",
      "url": "https://behaverse.org/scorers/ocir/scorer.wasm",
      "sha256": "7ae6f270cd842711e3dc4caa7ddbe9ed389ea44e1ab36dc0bd8919f102949a1f"
    }
  ],
  "test_cases": [
