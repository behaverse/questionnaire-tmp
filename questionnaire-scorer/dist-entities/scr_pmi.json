{
  "id": "scr_pmi",
  "name": "PMI Total Scoring",
  "content": {
    "en": {
      "status": "validated",
      "name": "PMI Total Scoring",
      "description": "Positive Mindset Index (PMI). Total = sum of the 6 items (each 1-5, range 6-30); higher = greater positive mental well-being (reverse-keyed items reversed by the runtime). No standard cut-offs."
    }
  },
  "x_publication": {
    "citation": "Barry, J. A., Folkard, A., & Ayliffe, W. (2014). Validation of a brief questionnaire measuring positive mindset in patients with uveitis. Psychology, Community & Health, 3(1) , 1-10. Open Access PDF",
    "year": 2014
  },
  "inputs": {
    "type": "object",
    "properties": {
      "scored_responses": {
        "type": "object",
        "patternProperties": {
          "^(pr_pmi_1|pr_pmi_2|pr_pmi_3|pr_pmi_4|pr_pmi_5|pr_pmi_6)$": {
            "type": "integer",
            "minimum": 1,
            "maximum": 5
          }
        }
      }
    },
    "required": [
      "scored_responses"
    ]
  },
  "output_schema": {
    "type": "object",
    "properties": {
      "scores": {
        "type": "object",
        "properties": {
          "total": {
            "type": "object",
            "properties": {
              "value": {
                "type": "number"
              }
            },
            "required": [
              "value"
            ]
          }
        },
        "required": [
          "total"
        ]
      },
      "missing_count": {
        "type": "integer",
        "minimum": 0
      }
    },
    "required": [
      "scores",
      "missing_count"
    ]
  },
  "implementations": [
    {
      "kind": "wasm",
      "url": "https://behaverse.org/scorers/pmi/scorer.wasm",
      "sha256": "2cad33e294e5c91d81320f1ec048f5385b4e6f659234a7468f01bbca93ff5b56"
    }
  ],
  "test_cases": [
    {
      "name": "floor",
      "input": {
        "scored_responses": {
          "pr_pmi_1": 1,
          "pr_pmi_2": 1,
          "pr_pmi_3": 1,
          "pr_pmi_4": 1,
          "pr_pmi_5": 1,
          "pr_pmi_6": 1
        }
      },
      "expected": {
        "scores": {
          "total": {
            "value": 6
          }
        },
        "missing_count": 0
      }
    },
    {
      "name": "mid",
      "input": {
        "scored_responses": {
          "pr_pmi_1": 3,
          "pr_pmi_2": 3,
          "pr_pmi_3": 3,
          "pr_pmi_4": 3,
          "pr_pmi_5": 3,
          "pr_pmi_6": 3
        }
      },
      "expected": {
        "scores": {
          "total": {
            "value": 18
          }
        },
        "missing_count": 0
      }
    },
    {
      "name": "ceiling",
      "input": {
        "scored_responses": {
          "pr_pmi_1": 5,
          "pr_pmi_2": 5,
          "pr_pmi_3": 5,
          "pr_pmi_4": 5,
          "pr_pmi_5": 5,
          "pr_pmi_6": 5
        }
      },
      "expected": {
        "scores": {
          "total": {
            "value": 30
          }
        },
        "missing_count": 0
      }
    }
  ]
}
