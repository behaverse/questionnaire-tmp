{
  "id": "scr_smd",
  "name": "SMD Total Scoring",
  "content": {
    "en": {
      "status": "validated",
      "name": "SMD Total Scoring",
      "description": "Social Media Disorder Scale (SMD). Total = sum of the 9 items (each 0-1, range 0-9); higher = greater disordered social-media use (reverse-keyed items reversed by the runtime). No standard cut-offs."
    }
  },
  "x_publication": {
    "citation": "van der Eijnden, R.J.J.M, Lemmens, J.S., & Valkenburg, P.M. (2016). The Social Media Disorder Scale. Computers in Human Behavior, 61, 478-487.",
    "year": 2016
  },
  "inputs": {
    "type": "object",
    "properties": {
      "scored_responses": {
        "type": "object",
        "patternProperties": {
          "^(pr_smd_1|pr_smd_2|pr_smd_3|pr_smd_4|pr_smd_5|pr_smd_6|pr_smd_7|pr_smd_8|pr_smd_9)$": {
            "type": "integer",
            "minimum": 0,
            "maximum": 1
          }
        }
      }
    },
    "required": [
      "scored_responses"
    ]
  },
  "output_schema": {
    "type": "object",
    "properties": {
      "scores": {
        "type": "object",
        "properties": {
          "total": {
            "type": "object",
            "properties": {
              "value": {
                "type": "number"
              }
            },
            "required": [
              "value"
            ]
          }
        },
        "required": [
          "total"
        ]
      },
      "missing_count": {
        "type": "integer",
        "minimum": 0
      }
    },
    "required": [
      "scores",
      "missing_count"
    ]
  },
  "implementations": [
    {
      "kind": "wasm",
      "url": "https://behaverse.org/scorers/smd/scorer.wasm",
      "sha256": "89a8484ef5dff2c3b5fa9c1f1a58061f9e854e4a99ed6a23eb7ec284e8b27fae"
    }
  ],
  "test_cases": [
    {
      "name": "floor",
      "input": {
        "scored_responses": {
          "pr_smd_1": 0,
          "pr_smd_2": 0,
          "pr_smd_3": 0,
          "pr_smd_4": 0,
          "pr_smd_5": 0,
          "pr_smd_6": 0,
          "pr_smd_7": 0,
          "pr_smd_8": 0,
          "pr_smd_9": 0
        }
      },
      "expected": {
        "scores": {
          "total": {
            "value": 0
          }
        },
        "missing_count": 0
      }
    },
    {
      "name": "mid",
      "input": {
        "scored_responses": {
          "pr_smd_1": 0,
          "pr_smd_2": 0,
          "pr_smd_3": 0,
          "pr_smd_4": 0,
          "pr_smd_5": 0,
          "pr_smd_6": 0,
          "pr_smd_7": 0,
          "pr_smd_8": 0,
          "pr_smd_9": 0
        }
      },
      "expected": {
        "scores": {
          "total": {
            "value": 0
          }
        },
        "missing_count": 0
      }
    },
    {
      "name": "ceiling",
      "input": {
        "scored_responses": {
          "pr_smd_1": 1,
          "pr_smd_2": 1,
          "pr_smd_3": 1,
          "pr_smd_4": 1,
          "pr_smd_5": 1,
          "pr_smd_6": 1,
          "pr_smd_7": 1,
          "pr_smd_8": 1,
          "pr_smd_9": 1
        }
      },
      "expected": {
        "scores": {
          "total": {
            "value": 9
          }
        },
        "missing_count": 0
      }
    }
  ]
}
