{
  "id": "scr_ccss",
  "name": "CCSS Scoring",
  "content": {
    "en": {
      "status": "validated",
      "name": "CCSS Scoring",
      "description": "Cooperative/Competitive Strategy Scale. Cooperation = mean of items 1-8 (items 4 and 6 reverse-scored), Competition = mean of items 9-19; each on a 1-7 scale. Higher = stronger motivation to use that strategy for success."
    }
  },
  "x_publication": {
    "citation": "Simmons CH, Wehner EA, Tucker SS, King CS (1988). The Cooperative/Competitive Strategy Scale. J Soc Psychol, 128(2), 199-205.",
    "year": 1988
  },
  "inputs": {
    "type": "object",
    "properties": {
      "scored_responses": {
        "type": "object",
        "patternProperties": {
          "^pr_ccss_(1[0-9]|[1-9])$": {
            "type": "integer",
            "minimum": 1,
            "maximum": 7
          }
        }
      }
    },
    "required": [
      "scored_responses"
    ]
  },
  "output_schema": {
    "type": "object",
    "properties": {
      "cooperation": {
        "type": "number"
      },
      "competition": {
        "type": "number"
      },
      "missing_count": {
        "type": "integer",
        "minimum": 0
      }
    },
    "required": [
      "cooperation",
      "competition",
      "missing_count"
    ]
  },
  "implementations": [
    {
      "kind": "wasm",
      "url": "https://behaverse.org/scorers/ccss/scorer.wasm",
      "sha256": "03fa82927e434c58ad7f8f9257ae778be6d47012e6a4cc7358dcf92313489565"
    }
  ],
