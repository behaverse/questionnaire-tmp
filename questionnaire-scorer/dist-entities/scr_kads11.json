{
  "id": "scr_kads11",
  "name": "KADS-11 Scoring",
  "content": {
    "en": {
      "status": "validated",
      "name": "KADS-11 Scoring",
      "description": "Kutcher Adolescent Depression Scale - 11-Item (KADS-11). Total = sum of the 11 items (each 0-3), range 0-33; a total of 6 or more is a positive screen."
    }
  },
  "x_publication": {
    "citation": "Sarah J Brooks, Stanley P Krulewicz, Stan Kutcher. The Kutcher Adolescent Depression Scale: ssessment of its evaluative properties over the course of an 8-week pediatric pharmacotherapy trial. 13 ( 3 ): J Child Adolesc Psychopharmacol 337-49 ( 2003 ).",
    "year": 2003
  },
  "inputs": {
    "type": "object",
    "properties": {
      "scored_responses": {
        "type": "object",
        "patternProperties": {
          "^(pr_kads11_1|pr_kads11_2|pr_kads11_3|pr_kads11_4|pr_kads11_5|pr_kads11_6|pr_kads11_7|pr_kads11_8|pr_kads11_9|pr_kads11_10|pr_kads11_11)$": {
            "type": "integer",
            "minimum": 0,
            "maximum": 3
          }
        }
      }
    },
    "required": [
      "scored_responses"
    ]
  },
  "output_schema": {
    "type": "object",
    "properties": {
      "scores": {
        "type": "object",
        "properties": {
          "total": {
            "type": "object",
            "properties": {
              "value": {
                "type": "number"
              },
              "severity": {
                "type": "string",
                "enum": [
                  "unlikely",
                  "possible"
                ]
              },
              "band": {
                "type": "object",
                "properties": {
                  "min": {
                    "type": "number"
                  },
                  "max": {
                    "type": "number"
                  },
                  "label": {
                    "type": "string"
                  }
                },
                "required": [
                  "min",
                  "max",
                  "label"
                ]
              }
            },
            "required": [
              "value"
            ]
          }
        },
        "required": [
          "total"
        ]
      },
      "missing_count": {
        "type": "integer",
        "minimum": 0
      }
    },
    "required": [
      "scores",
      "missing_count"
    ]
  },
  "implementations": [
    {
      "kind": "wasm",
      "url": "https://behaverse.org/scorers/kads11/scorer.wasm",
      "sha256": "6b43642dcce8a67cd33a57ee5adc46f54932bb309601fdfdb812f1fe2c18a747"
    }
  ],
