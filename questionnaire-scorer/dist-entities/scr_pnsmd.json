{
  "id": "scr_pnsmd",
  "name": "PN-SMD Total Scoring",
  "content": {
    "en": {
      "status": "validated",
      "name": "PN-SMD Total Scoring",
      "description": "Relationship satisfaction (PN-SMD). Total = sum of the 14 items (each 0-7, range 0-98); higher = greater relationship satisfaction (reverse-keyed items reversed by the runtime). No standard cut-offs."
    }
  },
  "x_publication": {
    "citation": "Mattson, R. E., Rogge, R. D., Johnson, M. D., Davidson, E. K. B., & Fincham, F. D. (2013). The positive and negative semantic dimensions of relationship satisfaction. Personal Relationships, 20 , 328-355.",
    "year": 2013
  },
  "inputs": {
    "type": "object",
    "properties": {
      "scored_responses": {
        "type": "object",
        "patternProperties": {
          "^(pr_pnsmd_1|pr_pnsmd_2|pr_pnsmd_3|pr_pnsmd_4|pr_pnsmd_5|pr_pnsmd_6|pr_pnsmd_7|pr_pnsmd_8|pr_pnsmd_9|pr_pnsmd_10|pr_pnsmd_11|pr_pnsmd_12|pr_pnsmd_13|pr_pnsmd_14)$": {
            "type": "integer",
            "minimum": 0,
            "maximum": 7
          }
        }
      }
    },
    "required": [
      "scored_responses"
    ]
  },
  "output_schema": {
    "type": "object",
    "properties": {
      "scores": {
        "type": "object",
        "properties": {
          "total": {
            "type": "object",
            "properties": {
              "value": {
                "type": "number"
              }
            },
            "required": [
              "value"
            ]
          }
        },
        "required": [
          "total"
        ]
      },
      "missing_count": {
        "type": "integer",
        "minimum": 0
      }
    },
    "required": [
      "scores",
      "missing_count"
    ]
  },
  "implementations": [
    {
      "kind": "wasm",
      "url": "https://behaverse.org/scorers/pnsmd/scorer.wasm",
      "sha256": "dd7e11a9c6e150133d101927fe8d137b757c53c64f51466bcd8249e4b75b29a8"
    }
  ],
