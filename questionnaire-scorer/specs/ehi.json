{
  "id": "ehi",
  "scorer_id": "scr_ehi",
  "name": "EHI Scoring",
  "status": "validated",
  "description": "The Edinburgh Handedness Inventory (short form). Edinburgh Handedness Inventory (short form). Laterality quotient = MEAN of the 4 items (each -100 left to +100 right), range -100 to +100; >+40 right-handed, <-40 left-handed, between = mixed.",
  "engine_spec": {
    "item_range": [
      -100,
      100
    ],
    "scores": [
      {
        "key": "laterality",
        "aggregate": "mean",
        "items": [
          "pr_ehi_1",
          "pr_ehi_2",
          "pr_ehi_3",
          "pr_ehi_4"
        ],
        "bands": [
          {
            "min": -100,
            "max": -41,
            "severity": "left",
            "label": "Left-handed"
          },
          {
            "min": -40,
            "max": 40,
            "severity": "mixed",
            "label": "Mixed / ambidextrous"
          },
          {
            "min": 41,
            "max": 100,
            "severity": "right",
            "label": "Right-handed"
          }
        ]
      }
    ]
  },
  "test_cases": [
    {
      "name": "left",
