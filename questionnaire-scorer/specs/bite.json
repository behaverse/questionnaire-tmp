{
  "id": "bite",
  "scorer_id": "scr_bite",
  "name": "BITe Total Scoring",
  "status": "validated",
  "description": "The Brief Irritability Test (BITe). Total = sum of the 5 items (each 1-6), range 5-30. Higher scores indicate greater irritability (reverse-keyed items are reversed by the runtime). No standard severity cut-offs.",
  "engine_spec": {
    "item_range": [
      1,
      6
    ],
    "scores": [
      {
        "key": "total",
        "aggregate": "sum",
        "items": [
          "pr_bite_1",
          "pr_bite_2",
          "pr_bite_3",
          "pr_bite_4",
          "pr_bite_5"
        ]
      }
    ]
  },
  "test_cases": [
    {
      "name": "floor",
      "input": {
        "scored_responses": {
          "pr_bite_1": 1,
          "pr_bite_2": 1,
          "pr_bite_3": 1,
          "pr_bite_4": 1,
          "pr_bite_5": 1
        }
      },
      "expected": {
        "scores": {
          "total": {
            "value": 5
          }
        },
        "missing_count": 0
      }
    },
    {
      "name": "mid",
      "input": {
        "scored_responses": {
          "pr_bite_1": 3,
          "pr_bite_2": 3,
          "pr_bite_3": 3,
          "pr_bite_4": 3,
          "pr_bite_5": 3
        }
      },
      "expected": {
