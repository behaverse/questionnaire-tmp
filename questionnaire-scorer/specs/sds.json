{
  "id": "sds",
  "scorer_id": "scr_sds",
  "name": "SDS Scoring",
  "status": "validated",
  "description": "Zung Self-Rating Depression Scale. Raw = sum of the 20 items (each 1-4; reverse items pre-scored), range 20-80; the SDS index = raw x 1.25 (range 25-100). Bands: <50 normal, 50-59 mild, 60-69 moderate, 70+ severe.",
  "engine_spec": {
    "item_range": [
      1,
      4
    ],
    "scores": [
      {
        "key": "index",
        "items": [
          "pr_sds_1",
          "pr_sds_2",
          "pr_sds_3",
          "pr_sds_4",
          "pr_sds_5",
          "pr_sds_6",
          "pr_sds_7",
          "pr_sds_8",
          "pr_sds_9",
          "pr_sds_10",
          "pr_sds_11",
          "pr_sds_12",
          "pr_sds_13",
          "pr_sds_14",
          "pr_sds_15",
          "pr_sds_16",
          "pr_sds_17",
          "pr_sds_18",
          "pr_sds_19",
          "pr_sds_20"
        ],
        "transform": {
          "mul": 1.25
        },
        "bands": [
          {
            "min": 25,
            "max": 49,
            "severity": "normal",
            "label": "Normal range"
          },
          {
            "min": 50,
            "max": 59,
            "severity": "mild",
            "label": "Mild depression"
          },
          {
            "min": 60,
            "max": 69,
            "severity": "moderate",
            "label": "Moderate to marked depression"
          },
          {
            "min": 70,
            "max": 100,
            "severity": "severe",
            "label": "Severe to extreme depression"
          }
        ]
      }
    ]
  },
