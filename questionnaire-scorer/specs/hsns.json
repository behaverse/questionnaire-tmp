{
  "id": "hsns",
  "scorer_id": "scr_hsns",
  "name": "HSNS Total Scoring",
  "status": "validated",
  "description": "Hypersensitive Narcissism Scale (HSNS). Total = sum of the 10 items (each 1-5), range 10-50. Higher scores indicate greater hypersensitive (vulnerable) narcissism (reverse-keyed items are reversed by the runtime). No standard severity cut-offs.",
  "engine_spec": {
    "item_range": [
      1,
      5
    ],
    "scores": [
      {
        "key": "total",
        "aggregate": "sum",
        "items": [
          "pr_hsns_1",
          "pr_hsns_2",
          "pr_hsns_3",
          "pr_hsns_4",
          "pr_hsns_5",
          "pr_hsns_6",
          "pr_hsns_7",
          "pr_hsns_8",
          "pr_hsns_9",
          "pr_hsns_10"
        ]
      }
    ]
  },
