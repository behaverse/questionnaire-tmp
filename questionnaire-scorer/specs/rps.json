{
  "id": "rps",
  "scorer_id": "scr_rps",
  "name": "RPS Scoring",
  "status": "validated",
  "description": "Risk Propensity Scale (RPS). Mean of the 7 items (each 1-9; reverse-keyed items reversed by the runtime); higher = greater risk-taking propensity. No standard cut-offs.",
  "engine_spec": {
    "item_range": [
      1,
      9
    ],
    "scores": [
      {
        "key": "total",
        "aggregate": "mean",
        "items": [
          "pr_rps_1",
          "pr_rps_2",
          "pr_rps_3",
          "pr_rps_4",
          "pr_rps_5",
          "pr_rps_6",
          "pr_rps_7"
        ]
      }
    ]
  },
  "test_cases": [
    {
      "name": "floor",
      "input": {
        "scored_responses": {
          "pr_rps_1": 1,
          "pr_rps_2": 1,
          "pr_rps_3": 1,
          "pr_rps_4": 1,
          "pr_rps_5": 1,
          "pr_rps_6": 1,
          "pr_rps_7": 1
        }
      },
      "expected": {
        "scores": {
          "total": {
            "value": 1
          }
        },
        "missing_count": 0
      }
    },
    {
