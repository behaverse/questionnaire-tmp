{
  "id": "asrm",
  "scorer_id": "scr_asrm",
  "name": "ASRM Scoring",
  "status": "validated",
  "description": "Altman Self-Rating Mania Scale (ASRM). Total = sum of the 5 items (each 0-4), range 0-20; a total of 6 or more suggests hypomania/mania.",
  "engine_spec": {
    "scores": [
      {
        "key": "total",
        "items": [
          "pr_asrm_1",
          "pr_asrm_2",
          "pr_asrm_3",
          "pr_asrm_4",
          "pr_asrm_5"
        ],
        "bands": [
          {
            "min": 0,
            "max": 5,
            "severity": "low",
            "label": "Not indicative of mania"
          },
          {
            "min": 6,
            "max": 20,
            "severity": "elevated",
            "label": "Possible hypomania or mania"
          }
        ]
      }
    ],
    "item_range": [
      0,
      4
    ]
  },
  "test_cases": [
