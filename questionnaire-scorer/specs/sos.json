{
  "id": "sos",
  "scorer_id": "scr_sos",
  "name": "SOS Total Scoring",
  "status": "validated",
  "description": "Service to Others in Sobriety (SOS) questionnaire. Total = sum of the 12 items (each 1-5), range 12-60. Higher scores indicate greater service to others in sobriety (reverse-keyed items are reversed by the runtime). No standard severity cut-offs.",
  "engine_spec": {
    "item_range": [
      1,
      5
    ],
    "scores": [
      {
        "key": "total",
        "aggregate": "sum",
        "items": [
          "pr_sos_1",
          "pr_sos_2",
          "pr_sos_3",
          "pr_sos_4",
          "pr_sos_5",
          "pr_sos_6",
          "pr_sos_7",
          "pr_sos_8",
          "pr_sos_9",
          "pr_sos_10",
          "pr_sos_11",
          "pr_sos_12"
        ]
      }
    ]
  },
  "test_cases": [
    {
      "name": "floor",
      "input": {
        "scored_responses": {
          "pr_sos_1": 1,
          "pr_sos_2": 1,
          "pr_sos_3": 1,
          "pr_sos_4": 1,
          "pr_sos_5": 1,
          "pr_sos_6": 1,
          "pr_sos_7": 1,
          "pr_sos_8": 1,
          "pr_sos_9": 1,
          "pr_sos_10": 1,
          "pr_sos_11": 1,
          "pr_sos_12": 1
        }
      },
      "expected": {
