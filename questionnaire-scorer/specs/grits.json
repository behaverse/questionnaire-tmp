{
  "id": "grits",
  "scorer_id": "scr_grits",
  "name": "Grit-S Total Scoring",
  "status": "validated",
  "description": "Short Grit Scale (Grit-S). Score = MEAN of the 8 items (each 1-5), range 1-5. Higher scores indicate greater grit (perseverance and consistency of interest) (reverse-keyed items are reversed by the runtime). No standard severity cut-offs.",
  "engine_spec": {
    "item_range": [
      1,
      5
    ],
    "scores": [
      {
        "key": "total",
        "aggregate": "mean",
        "items": [
