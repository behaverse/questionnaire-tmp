{
  "id": "epds",
  "scorer_id": "scr_epds",
  "name": "EPDS Scoring",
  "status": "validated",
  "description": "Edinburgh Postnatal Depression Scale (EPDS). Total = sum of the 10 items (each 0-3), range 0-30; 10-12 possible and 13+ probable depression.",
  "engine_spec": {
    "scores": [
      {
        "key": "total",
        "items": [
          "pr_epds_1",
          "pr_epds_2",
          "pr_epds_3",
          "pr_epds_4",
          "pr_epds_5",
          "pr_epds_6",
          "pr_epds_7",
          "pr_epds_8",
          "pr_epds_9",
          "pr_epds_10"
        ],
        "bands": [
          {
            "min": 0,
            "max": 9,
            "severity": "low",
            "label": "Low likelihood of depression"
          },
          {
            "min": 10,
            "max": 12,
            "severity": "possible",
            "label": "Possible depression"
          },
          {
            "min": 13,
            "max": 30,
            "severity": "probable",
            "label": "Probable depression"
          }
        ]
      }
    ],
    "item_range": [
      0,
      3
    ]
  },
  "test_cases": [
    {
