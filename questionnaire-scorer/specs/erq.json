{
  "id": "erq",
  "scorer_id": "scr_erq",
  "name": "ERQ Standard Scoring",
  "status": "validated",
  "description": "Emotion Regulation Questionnaire (Gross & John, 2003). Two subscale MEAN scores (each item 1-7): Cognitive Reappraisal (items 1,3,5,7,8,10) and Expressive Suppression (items 2,4,6,9). Higher = greater habitual use of that strategy; no severity cut-offs.",
  "publication": {
    "citation": "Gross JJ, John OP (2003). Individual differences in two emotion regulation processes: implications for affect, relationships, and well-being. J Pers Soc Psychol, 85(2), 348-362.",
    "year": 2003
  },
  "engine_spec": {
    "item_range": [
      1,
      7
    ],
    "scores": [
      {
        "key": "reappraisal",
        "aggregate": "mean",
        "items": [
          "pr_erq_1",
          "pr_erq_3",
          "pr_erq_5",
          "pr_erq_7",
          "pr_erq_8",
          "pr_erq_10"
        ]
      },
      {
        "key": "suppression",
        "aggregate": "mean",
        "items": [
          "pr_erq_2",
          "pr_erq_4",
          "pr_erq_6",
          "pr_erq_9"
        ]
      }
    ]
  },
