{
  "id": "sas",
  "scorer_id": "scr_sas",
  "name": "SAS Scoring",
  "status": "validated",
  "description": "Zung Self-Rating Anxiety Scale. Raw = sum of the 20 items (each 1-4; reverse items pre-scored), range 20-80; the SAS index = raw x 1.25 (range 25-100). Bands: <45 normal, 45-59 mild-moderate, 60-74 marked-severe, 75+ extreme.",
  "engine_spec": {
    "item_range": [
      1,
      4
    ],
    "scores": [
      {
        "key": "index",
        "items": [
          "pr_sas_1",
          "pr_sas_2",
          "pr_sas_3",
          "pr_sas_4",
          "pr_sas_5",
          "pr_sas_6",
          "pr_sas_7",
          "pr_sas_8",
          "pr_sas_9",
          "pr_sas_10",
          "pr_sas_11",
          "pr_sas_12",
          "pr_sas_13",
          "pr_sas_14",
          "pr_sas_15",
          "pr_sas_16",
          "pr_sas_17",
          "pr_sas_18",
          "pr_sas_19",
          "pr_sas_20"
        ],
        "transform": {
          "mul": 1.25
        },
        "bands": [
          {
            "min": 25,
            "max": 44,
            "severity": "normal",
            "label": "Normal range"
          },
          {
            "min": 45,
            "max": 59,
            "severity": "mild_moderate",
            "label": "Mild to moderate anxiety"
          },
          {
            "min": 60,
            "max": 74,
            "severity": "marked_severe",
            "label": "Marked to severe anxiety"
          },
          {
            "min": 75,
            "max": 100,
            "severity": "extreme",
            "label": "Extreme anxiety"
          }
        ]
      }
    ]
  },
