{
  "id": "bfas",
  "scorer_id": "scr_bfas",
  "name": "BFAS Scoring",
  "status": "validated",
  "description": "Facebook Addition Scale (BFAS). Total = number of items endorsed 'sometimes' or more often (polythetic 0/1 scoring) across the 6 items, range 0-6; endorsing 4 or more is the recommended at-risk threshold.",
  "engine_spec": {
    "item_range": [
      0,
      1
    ],
    "scores": [
      {
        "key": "total",
        "items": [
          "pr_bfas_1",
          "pr_bfas_2",
          "pr_bfas_3",
          "pr_bfas_4",
          "pr_bfas_5",
          "pr_bfas_6"
        ],
        "bands": [
          {
            "min": 0,
            "max": 3,
            "severity": "below",
            "label": "Below at-risk threshold"
          },
          {
            "min": 4,
            "max": 6,
            "severity": "at_risk",
            "label": "At risk of Facebook addiction"
          }
        ]
      }
    ]
  },
  "test_cases": [
    {
      "name": "below",
      "input": {
        "scored_responses": {
          "pr_bfas_1": 0,
          "pr_bfas_2": 0,
          "pr_bfas_3": 0,
          "pr_bfas_4": 0,
          "pr_bfas_5": 0,
          "pr_bfas_6": 0
        }
      },
      "expected": {
        "scores": {
          "total": {
            "value": 0,
            "severity": "below",
            "band": {
              "min": 0,
              "max": 3,
              "label": "Below at-risk threshold"
            }
          }
        },
        "missing_count": 0
      }
    },
    {
      "name": "at-risk",
      "input": {
        "scored_responses": {
          "pr_bfas_1": 1,
          "pr_bfas_2": 1,
          "pr_bfas_3": 1,
          "pr_bfas_4": 1,
          "pr_bfas_5": 1,
          "pr_bfas_6": 1
        }
      },
      "expected": {
        "scores": {
          "total": {
            "value": 6,
            "severity": "at_risk",
            "band": {
              "min": 4,
              "max": 6,
              "label": "At risk of Facebook addiction"
            }
          }
        },
        "missing_count": 0
      }
    }
  ],
  "publication": {
    "citation": "Andreassen, C.S., Torsheim, T., Brunborg, G.S., & Pallesen, S. (2010). Development of a Facebook addiction scale. Psychological Reports, 110 , 2, 501-517.",
    "year": 2010
  }
}
