{
  "id": "shs",
  "scorer_id": "scr_shs",
  "name": "SHS Scoring",
  "status": "validated",
  "description": "Subjective Happiness Scale (SHS). Mean of the 4 items (each 1-7; reverse-keyed items reversed by the runtime); higher = greater subjective happiness. No standard cut-offs.",
  "engine_spec": {
    "item_range": [
      1,
      7
    ],
    "scores": [
      {
        "key": "total",
        "aggregate": "mean",
        "items": [
          "pr_shs_1",
          "pr_shs_2",
          "pr_shs_3",
          "pr_shs_4"
        ]
      }
    ]
  },
  "test_cases": [
    {
      "name": "floor",
      "input": {
        "scored_responses": {
          "pr_shs_1": 1,
          "pr_shs_2": 1,
          "pr_shs_3": 1,
          "pr_shs_4": 1
        }
      },
      "expected": {
        "scores": {
          "total": {
            "value": 1
          }
        },
        "missing_count": 0
      }
    },
    {
      "name": "mid",
      "input": {
        "scored_responses": {
          "pr_shs_1": 4,
          "pr_shs_2": 4,
          "pr_shs_3": 4,
          "pr_shs_4": 4
        }
      },
      "expected": {
        "scores": {
          "total": {
            "value": 4
          }
        },
        "missing_count": 0
      }
    },
    {
      "name": "ceiling",
      "input": {
        "scored_responses": {
          "pr_shs_1": 7,
          "pr_shs_2": 7,
          "pr_shs_3": 7,
          "pr_shs_4": 7
        }
      },
      "expected": {
        "scores": {
          "total": {
            "value": 7
          }
        },
        "missing_count": 0
      }
    }
  ],
  "publication": {
    "citation": "Lyubomirsky, S. & Lepper, H. S. (1999). A measure of subjective happines: Preliminary reliability and construct validation. Social indicators research, 46 , 137-155.",
    "year": 1999
  }
}
