DATABASE_URL=postgresql://postgres:postgres@localhost:5432/library
LIBRARY_CORS_ORIGINS=http://localhost:5173,http://localhost:5175
# CONTENT_DIR / SCHEMAS_DIR default to in-repo paths; override only for a custom layout
# CONTENT_DIR=
# SCHEMAS_DIR=./schemas
IDENTITY_JWKS_URL=http://localhost:8100/.well-known/jwks.json
IDENTITY_ISSUER=http://localhost:8100
IDENTITY_AUDIENCE=questionnaire-apps
# expose interactive API docs (/docs, /openapi.json) — OFF unless set truthy
# ENABLE_DOCS=1
# optional error tracking — dormant unless SENTRY_DSN is set (see docs/monitoring.md)
# SENTRY_DSN=
# SENTRY_ENVIRONMENT=production
